{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/packages/runx/github-issue-to-pr/result/v1.json",
  "x-runx-packet-id": "runx/github-issue-to-pr.result.v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "outcome",
    "repository",
    "issue_number",
    "branch",
    "commit",
    "publication",
    "errors",
    "summary",
    "files",
    "tests",
    "test_assurance",
    "candidate",
    "governance"
  ],
  "properties": {
    "schema": {
      "const": "runx/github-issue-to-pr.result.v1"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "blocked"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "local_change",
        "published",
        "blocked"
      ]
    },
    "repository": {
      "type": "string"
    },
    "issue_number": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "commit": {
      "type": "string"
    },
    "publication": {
      "type": "object",
      "required": [
        "status",
        "pr_number",
        "url",
        "readback_uri"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_requested",
            "failed",
            "published"
          ]
        },
        "pr_number": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "readback_uri": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "status",
          "evidence"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "test_assurance": {
      "const": "host_reported"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "repo_root",
        "branch",
        "commit"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "unverified"
          ]
        },
        "repo_root": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "status",
        "receipt_digest",
        "contract_digest"
      ],
      "properties": {
        "kind": {
          "enum": [
            "repository",
            "scafld"
          ]
        },
        "status": {
          "enum": [
            "not_required",
            "verified",
            "unverified"
          ]
        },
        "receipt_digest": {
          "type": "string"
        },
        "contract_digest": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}
