{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/packages/runx/dispute-respond/response/v1.json",
  "x-runx-packet-id": "runx/dispute-respond.response.v1",
  "type": "object",
  "required": [
    "schema",
    "decision",
    "provider",
    "account_id",
    "dispute_id",
    "posture",
    "summary",
    "open_questions",
    "sources",
    "citations",
    "case_evidence",
    "charge_evidence",
    "observed_at",
    "acquisition",
    "request",
    "findings",
    "filing_status"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "runx/dispute-respond.response.v1"
    },
    "decision": {
      "enum": [
        "ready",
        "held"
      ]
    },
    "provider": {
      "const": "stripe"
    },
    "account_id": {
      "type": "string"
    },
    "dispute_id": {
      "type": "string"
    },
    "posture": {
      "enum": [
        "contest",
        "refund_already_sent",
        "accept",
        "operator_review",
        "needs_more_evidence"
      ]
    },
    "summary": {
      "type": "string"
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "content",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "delivery",
              "consent",
              "support",
              "contract",
              "refund",
              "other",
              "provider"
            ]
          },
          "content": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "evidence_id",
          "quote"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "evidence_id": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          }
        }
      }
    },
    "case_evidence": {
      "type": "object",
      "additionalProperties": true,
      "description": "Exact prior native provider-operation evidence. The native operation contract owns its fields; supplied prior evidence does not independently reverify a provider call."
    },
    "charge_evidence": {
      "type": "object",
      "additionalProperties": true,
      "description": "Exact original-charge native provider-operation evidence, retained with its original receipt. Native provider contracts own this packet."
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "acquisition": {
      "enum": [
        "provider_read",
        "prior_evidence"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": true,
      "description": "Exact Stripe dispute.file operation arguments. The owning connector input schema and native provider boundary validate the request; this package does not redefine that public provider contract."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "filing_status": {
      "const": "not_attempted"
    }
  }
}
