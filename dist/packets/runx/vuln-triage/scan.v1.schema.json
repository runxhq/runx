{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/packages/runx/vuln-triage/scan/v1.json",
  "x-runx-packet-id": "runx/vuln-triage.scan.v1",
  "type": "object",
  "required": [
    "schema",
    "decision",
    "target",
    "dependency_inventory",
    "advisories",
    "escalation_criteria",
    "remediation_plan",
    "operator_summary",
    "evidence_binding",
    "validation",
    "publication_status"
  ],
  "properties": {
    "schema": { "type": "string", "const": "runx/vuln-triage.scan.v1" },
    "decision": {
      "type": "string",
      "enum": [
        "needs_agent",
        "needs_verified_evidence",
        "no_verified_findings",
        "needs_more_evidence",
        "remediate",
        "monitor",
        "needs_human"
      ]
    },
    "target": { "type": "string" },
    "dependency_inventory": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": ["name", "version", "path", "direct", "development"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "direct": { "type": "boolean" },
          "development": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "advisories": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "escalation_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["advisory_id", "trigger", "action"],
        "properties": {
          "advisory_id": { "type": "string", "minLength": 1 },
          "trigger": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "remediation_plan": { "type": "object", "additionalProperties": true },
    "operator_summary": { "type": "object", "additionalProperties": true },
    "evidence_binding": { "type": "object", "additionalProperties": true },
    "validation": {
      "type": "object",
      "required": ["status", "findings"],
      "properties": {
        "status": { "type": "string", "enum": ["pass", "fail"] },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "message": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "publication_status": { "type": "string", "const": "not_published" }
  },
  "additionalProperties": false
}
