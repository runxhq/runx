{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$id": "https://schemas.runx.ai/packages/runx/code-intake/intake/v1.json",
  "x-runx-packet-id": "runx/code-intake.intake.v1",
  "required": [
    "schema",
    "input_digest",
    "request",
    "project_context",
    "operator_context",
    "source_context",
    "intake_report",
    "change_set",
    "status",
    "execution"
  ],
  "properties": {
    "schema": {
      "const": "runx/code-intake.intake.v1"
    },
    "input_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "request": {
      "type": "string",
      "minLength": 1
    },
    "project_context": {
      "type": "string"
    },
    "operator_context": {
      "type": "string"
    },
    "source_context": {
      "type": "object",
      "additionalProperties": true
    },
    "intake_report": {
      "type": "object",
      "required": [
        "category",
        "severity",
        "summary",
        "suggested_reply",
        "recommended_lane",
        "rationale",
        "needs_human",
        "operator_notes",
        "open_questions"
      ],
      "properties": {
        "category": {
          "enum": [
            "bug",
            "feature_request",
            "docs",
            "billing",
            "account",
            "question",
            "other"
          ]
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "suggested_reply": {
          "type": "string",
          "minLength": 1
        },
        "recommended_lane": {
          "enum": [
            "host",
            "code-plan",
            "github-issue-to-pr",
            "reply-only",
            "manual-review"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "needs_human": {
          "type": "boolean"
        },
        "operator_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "change_set": {
      "type": "object",
      "required": [
        "change_set_id",
        "source_digest",
        "summary",
        "category",
        "severity",
        "recommended_lane",
        "target_surfaces",
        "shared_invariants",
        "success_criteria"
      ],
      "properties": {
        "change_set_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "recommended_lane": {
          "type": "string"
        },
        "thread_locator": {
          "type": "string"
        },
        "target_surfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "surface",
              "kind",
              "mutating",
              "rationale"
            ],
            "properties": {
              "surface": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "repo",
                  "package",
                  "docs",
                  "support",
                  "other"
                ]
              },
              "mutating": {
                "type": "boolean"
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "shared_invariants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "success_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "ready",
        "needs_context",
        "reply_only"
      ]
    },
    "execution": {
      "type": "object",
      "required": [
        "status",
        "authority"
      ],
      "properties": {
        "status": {
          "const": "not_started"
        },
        "authority": {
          "const": "none_granted"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
