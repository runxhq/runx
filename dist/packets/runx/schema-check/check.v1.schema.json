{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/packages/runx/schema-check/check/v1.json",
  "x-runx-packet-id": "runx/schema-check.check.v1",
  "type": "object",
  "required": [
    "schema",
    "decision",
    "policy_result",
    "breaking_changes",
    "validation_results",
    "migration_notes",
    "proposal",
    "validation"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "runx/schema-check.check.v1"
    },
    "decision": {
      "type": "string",
      "enum": [
        "compatible",
        "refused"
      ]
    },
    "policy_result": {
      "type": "string",
      "enum": [
        "allowed",
        "blocked_by_policy",
        "invalid_input"
      ]
    },
    "breaking_changes": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "path",
          "old_contract",
          "new_contract",
          "policy_rule"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "old_contract": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "new_contract": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "policy_rule": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "validation_results": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "sample_index",
          "valid",
          "errors"
        ],
        "additionalProperties": false,
        "properties": {
          "sample_index": {
            "type": "integer",
            "minimum": 0
          },
          "valid": {
            "type": "boolean"
          },
          "errors": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        }
      }
    },
    "migration_notes": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "proposal": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "status": {
          "const": "proposed"
        },
        "gate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "live_write_performed": {
          "const": false
        },
        "current_schema_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "proposed_schema_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "samples_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "changed_paths": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "status",
        "findings"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        },
        "findings": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          }
        }
      }
    }
  }
}
