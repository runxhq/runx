{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/governed_outbound/plan/v1.json",
  "x-runx-packet-id": "runx.governed_outbound.plan.v1",
  "x-runx-generated-from": "skills/governed-outbound/run.yaml#root.runners.plan.steps.3",
  "type": "object",
  "required": [
    "outbound_plan"
  ],
  "properties": {
    "outbound_plan": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "minLength": 1,
          "type": "string"
        },
        "completion": {
          "const": "plan_only"
        },
        "decision": {
          "const": "ready"
        },
        "principal": {
          "minLength": 1,
          "type": "string"
        },
        "provider_actions": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "provider_delivery": {
          "const": "not_executed"
        },
        "redaction": {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "source_digest": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "digest",
            "source_digest"
          ],
          "type": "object"
        },
        "send_plan": {
          "additionalProperties": true,
          "properties": {
            "audience": {
              "properties": {
                "ref": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "ref"
              ],
              "type": "object"
            },
            "content": {
              "properties": {
                "digest": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "digest"
              ],
              "type": "object"
            },
            "decision": {
              "const": "ready"
            },
            "principal": {
              "properties": {
                "ref": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "ref"
              ],
              "type": "object"
            },
            "success_checkpoint": {
              "properties": {
                "milestone": {
                  "const": "provider_delivery_required"
                }
              },
              "required": [
                "milestone"
              ],
              "type": "object"
            }
          },
          "required": [
            "decision",
            "principal",
            "audience",
            "content",
            "success_checkpoint"
          ],
          "type": "object"
        },
        "source": {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "fetched_at": {
              "type": "string"
            },
            "final_url": {
              "format": "uri",
              "type": "string"
            }
          },
          "required": [
            "final_url",
            "digest",
            "fetched_at"
          ],
          "type": "object"
        }
      },
      "required": [
        "decision",
        "completion",
        "provider_delivery",
        "principal",
        "audience",
        "source",
        "redaction",
        "provider_actions",
        "send_plan"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false
}
