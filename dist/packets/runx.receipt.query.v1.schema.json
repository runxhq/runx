{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/receipt/query/v1.json",
  "x-runx-packet-id": "runx.receipt.query.v1",
  "type": "object",
  "required": ["schema", "source", "store_label", "filter", "receipt_ids", "receipts", "receipt_details", "verification"],
  "properties": {
    "schema": { "const": "runx.receipt.query.v1" },
    "source": { "const": "native_receipt_store" },
    "store_label": { "type": "string", "minLength": 1 },
    "filter": { "type": "object", "additionalProperties": true },
    "receipt_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "receipts": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "receipt_details": { "type": "array", "maxItems": 100, "items": { "type": "object", "additionalProperties": true } },
    "verification": {
      "type": "object",
      "required": ["signature_mode", "checked", "intact", "trees", "findings"],
      "properties": {
        "signature_mode": { "enum": ["production", "local-development"] },
        "checked": { "type": "boolean" },
        "intact": { "type": ["boolean", "null"] },
        "trees": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "findings": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
