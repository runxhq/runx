{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/data/sql_analysis_plan/v1.json",
  "x-runx-packet-id": "runx.data.sql_analysis_plan.v1",
  "x-runx-generated-from": "skills/sql-analysis/run.yaml#root.runners.plan.steps.3",
  "additionalProperties": false,
  "properties": {
    "decision": {
      "enum": [
        "ready",
        "no_suitable_query",
        "invalid_parameters"
      ]
    },
    "dialect": {
      "maxLength": 64,
      "type": "string"
    },
    "executed": {
      "const": false
    },
    "max_rows": {
      "maximum": 1000,
      "minimum": 1,
      "type": "integer"
    },
    "missing_context": {
      "items": {
        "maxLength": 1000,
        "type": "string"
      },
      "maxItems": 16,
      "type": "array"
    },
    "parameters": {
      "additionalProperties": true,
      "type": "object"
    },
    "query_id": {
      "maxLength": 192,
      "type": "string"
    },
    "question": {
      "maxLength": 8000,
      "type": "string"
    },
    "reason": {
      "maxLength": 4000,
      "type": "string"
    },
    "result_description": {
      "maxLength": 4000,
      "type": "string"
    },
    "source_ref": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$",
      "type": "string"
    },
    "validation": {
      "additionalProperties": true,
      "type": "object"
    }
  },
  "required": [
    "decision",
    "question",
    "source_ref",
    "dialect",
    "query_id",
    "parameters",
    "max_rows",
    "reason",
    "missing_context",
    "result_description",
    "executed",
    "validation"
  ],
  "type": "object"
}
