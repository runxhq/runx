{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/ops_desk/dispatch_decision/v1.json",
  "x-runx-packet-id": "runx.ops_desk.dispatch_decision.v1",
  "x-runx-generated-from": "skills/ops-desk/run.yaml#root.runners.advance.steps.0",
  "type": "object",
  "required": [
    "decision",
    "reason"
  ],
  "properties": {
    "decision": {
      "type": "string"
    },
    "dispatch": {
      "additionalProperties": false,
      "properties": {
        "consequence": {
          "type": "string"
        },
        "member": {
          "minLength": 1,
          "type": "string"
        },
        "needed_scope": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "skill": {
          "minLength": 1,
          "type": "string"
        },
        "task": {
          "minLength": 1,
          "type": "string"
        },
        "verification": {
          "additionalProperties": false,
          "properties": {
            "expected_effect": {
              "type": [
                "string",
                "null"
              ]
            },
            "expected_receipt": {
              "type": [
                "string",
                "null"
              ]
            },
            "readback": {
              "type": "string"
            }
          },
          "required": [
            "expected_receipt",
            "readback"
          ],
          "type": "object"
        }
      },
      "required": [
        "member",
        "skill",
        "task",
        "needed_scope",
        "consequence",
        "verification"
      ],
      "type": "object",
      "description": "Dispatch payload when decision is dispatch."
    },
    "escalation": {
      "additionalProperties": false,
      "properties": {
        "approval_prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "ask": {
          "minLength": 1,
          "type": "string"
        },
        "to": {
          "minLength": 1,
          "type": "string"
        },
        "trigger": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "to",
        "trigger",
        "ask",
        "approval_prompt"
      ],
      "type": "object",
      "description": "Escalation payload when decision is escalate."
    },
    "reason": {
      "type": "string"
    },
    "resolution": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "type": "object",
      "description": "Resolution payload when decision is done."
    }
  },
  "additionalProperties": false
}
