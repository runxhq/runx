{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/git/log/v1.json",
  "x-runx-packet-id": "runx.git.log.v1",
  "type": "object",
  "required": [
    "repo_root",
    "revision",
    "commits",
    "truncated"
  ],
  "properties": {
    "repo_root": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "commit",
          "author",
          "date",
          "subject",
          "files"
        ],
        "properties": {
          "commit": {
            "type": "string",
            "minLength": 1
          },
          "author": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      },
      "maxItems": 200
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
