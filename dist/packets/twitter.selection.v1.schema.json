{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/twitter/selection/v1.json",
  "x-runx-packet-id": "twitter.selection.v1",
  "x-runx-generated-from": "skills/twitter/run.yaml#root.runners.select.steps.5",
  "additionalProperties": false,
  "properties": {
    "blockers": {
      "items": {
        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "type": "array"
    },
    "decision": {
      "enum": [
        "ready",
        "needs_input"
      ],
      "type": "string"
    },
    "matched": {
      "minimum": 0,
      "type": "integer"
    },
    "objective": {
      "maxLength": 10000,
      "type": "string"
    },
    "plan_digest": {
      "pattern": "^(?:sha256:[0-9a-f]{64})?$",
      "type": "string"
    },
    "predicate": {
      "maxProperties": 10,
      "minProperties": 1,
      "type": "object"
    },
    "principal": {
      "maxLength": 1000,
      "type": "string"
    },
    "scanned": {
      "minimum": 0,
      "type": "integer"
    },
    "source": {
      "enum": [
        "archive",
        "users_archive"
      ],
      "type": "string"
    },
    "truncated": {
      "type": "boolean"
    },
    "twitter_plan": {
      "additionalProperties": false,
      "properties": {
        "acts": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "act_id": {
                "pattern": "^act-[A-Za-z0-9._:-]+$",
                "type": "string"
              },
              "consequence": {
                "const": "live_mutation"
              },
              "kind": {
                "enum": [
                  "delete_post",
                  "unfollow"
                ],
                "type": "string"
              },
              "params": {
                "maxProperties": 5,
                "minProperties": 1,
                "type": "object"
              },
              "rationale": {
                "maxLength": 4000,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "act_id",
              "kind",
              "params",
              "consequence",
              "rationale"
            ],
            "type": "object"
          },
          "maxItems": 5000,
          "type": "array"
        },
        "blockers": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "type": "array"
        },
        "decision": {
          "const": "ready"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "type": "array"
        },
        "gates": {
          "additionalProperties": false,
          "properties": {
            "approval_ref": {
              "const": "approval:pending"
            },
            "human_approval_required": {
              "const": true
            }
          },
          "required": [
            "human_approval_required",
            "approval_ref"
          ],
          "type": "object"
        },
        "objective": {
          "maxLength": 10000,
          "minLength": 1,
          "type": "string"
        },
        "open_questions": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "type": "array"
        },
        "principal": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        "success_checkpoint": {
          "additionalProperties": false,
          "properties": {
            "description": {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            "milestone": {
              "const": "bulk_plan_ready_for_approval"
            }
          },
          "required": [
            "milestone",
            "description"
          ],
          "type": "object"
        }
      },
      "required": [
        "decision",
        "objective",
        "principal",
        "acts",
        "gates",
        "evidence_refs",
        "open_questions",
        "blockers",
        "success_checkpoint"
      ],
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "decision",
    "objective",
    "principal",
    "source",
    "predicate",
    "matched",
    "scanned",
    "truncated",
    "twitter_plan",
    "plan_digest",
    "blockers"
  ],
  "type": "object"
}
