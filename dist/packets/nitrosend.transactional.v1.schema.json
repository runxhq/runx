{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/nitrosend/transactional/v1.json",
  "x-runx-packet-id": "nitrosend.transactional.v1",
  "x-runx-generated-from": "skills/nitrosend/run.yaml#root.runners.plan-transactional.steps.0",
  "type": "object",
  "required": [
    "transactional_plan"
  ],
  "properties": {
    "transactional_plan": {
      "additionalProperties": false,
      "properties": {
        "blockers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "channel": {
          "type": "string"
        },
        "decision": {
          "enum": [
            "ready",
            "needs_input",
            "reject"
          ],
          "type": "string"
        },
        "human_actions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "idempotency_key": {
          "type": "string"
        },
        "needs_input": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ordered_tool_calls": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "purpose": {
                "minLength": 1,
                "type": "string"
              },
              "requires_confirmation": {
                "type": "boolean"
              },
              "tool": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "tool",
              "purpose",
              "requires_confirmation"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "recipient": {
          "type": "string"
        },
        "rejection_reason": {
          "type": "string"
        },
        "success_checkpoint": {
          "additionalProperties": false,
          "properties": {
            "description": {
              "minLength": 1,
              "type": "string"
            },
            "milestone": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "milestone",
            "description"
          ],
          "type": "object"
        },
        "unsupported_requirements": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "decision"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false
}
