{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/command/execution/v1.json",
  "x-runx-packet-id": "runx.command.execution.v1",
  "type": "object",
  "required": [
    "schema",
    "decision",
    "command_digest",
    "cwd",
    "exit_code",
    "timed_out",
    "duration_ms",
    "stdout",
    "stderr",
    "stdout_digest",
    "stderr_digest",
    "stdout_bytes",
    "stderr_bytes",
    "stdout_truncated",
    "stderr_truncated",
    "json",
    "errors"
  ],
  "properties": {
    "schema": { "const": "runx.command.execution.v1" },
    "decision": { "enum": ["completed", "failed", "stopped"] },
    "command_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "cwd": { "type": "string", "minLength": 1 },
    "exit_code": { "type": ["integer", "null"] },
    "timed_out": { "type": "boolean" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "stdout": { "type": "string", "maxLength": 1048576 },
    "stderr": { "type": "string", "maxLength": 1048576 },
    "stdout_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "stderr_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "stdout_bytes": { "type": "integer", "minimum": 0, "maximum": 1048576 },
    "stderr_bytes": { "type": "integer", "minimum": 0, "maximum": 1048576 },
    "stdout_truncated": { "type": "boolean" },
    "stderr_truncated": { "type": "boolean" },
    "json": {},
    "errors": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string" },
          "exit_code": { "type": ["integer", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
