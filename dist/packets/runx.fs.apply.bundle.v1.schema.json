{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/fs/apply_bundle/v1.json",
  "x-runx-packet-id": "runx.fs.apply_bundle.v1",
  "type": "object",
  "required": ["repo_root", "write_count", "delete_count", "writes", "deletes"],
  "properties": {
    "repo_root": { "type": "string", "minLength": 1 },
    "write_count": { "type": "integer", "minimum": 0 },
    "delete_count": { "type": "integer", "minimum": 0 },
    "writes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "bytes_written", "sha256", "diff"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "bytes_written": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "before_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "diff": { "type": "string", "description": "The unified diff from what the file held to what the change left; empty when it left the file as it was." }
        },
        "additionalProperties": false
      }
    },
    "deletes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "status", "diff"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "status": { "enum": ["deleted", "already_absent"] },
          "before_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "diff": { "type": "string", "description": "The unified diff from what the file held to what the change left; empty when it left the file as it was." }
        },
        "additionalProperties": false
      }
    },
    "journal": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}
