{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/policy_proposal/v1.json",
  "x-runx-packet-id": "runx.policy_proposal.v1",
  "x-runx-generated-from": "skills/policy-author/run.yaml#root.runners.author.steps.3",
  "type": "object",
  "required": [
    "policy_proposal"
  ],
  "properties": {
    "policy_proposal": {
      "additionalProperties": false,
      "properties": {
        "blockers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "decision": {
          "enum": [
            "ready",
            "needs_input",
            "reject"
          ],
          "type": "string"
        },
        "needs_input": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "policy": {
          "additionalProperties": true,
          "properties": {
            "schema": {
              "const": "runx.operational_policy.v1"
            }
          },
          "required": [
            "schema"
          ],
          "type": [
            "object",
            "null"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "success_checkpoint": {
          "additionalProperties": true,
          "properties": {
            "description": {
              "type": "string"
            },
            "milestone": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "validation": {
          "additionalProperties": false,
          "properties": {
            "engine": {
              "const": "runx policy"
            },
            "findings": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "code",
                  "path",
                  "message"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "readback": {
              "additionalProperties": true,
              "type": [
                "object",
                "null"
              ]
            },
            "reason": {
              "type": "string"
            },
            "status": {
              "enum": [
                "pass",
                "fail",
                "not_run"
              ],
              "type": "string"
            }
          },
          "required": [
            "status",
            "engine",
            "findings",
            "readback",
            "reason"
          ],
          "type": "object"
        }
      },
      "required": [
        "decision",
        "policy",
        "validation",
        "rationale",
        "blockers",
        "needs_input",
        "success_checkpoint"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false
}
