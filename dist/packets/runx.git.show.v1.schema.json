{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/git/show/v1.json",
  "x-runx-packet-id": "runx.git.show.v1",
  "type": "object",
  "required": [
    "repo_root",
    "revision",
    "text",
    "files",
    "omitted",
    "truncated"
  ],
  "properties": {
    "repo_root": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "omitted": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
