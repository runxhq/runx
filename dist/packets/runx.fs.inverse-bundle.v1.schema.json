{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/fs/inverse_bundle/v1.json",
  "x-runx-packet-id": "runx.fs.inverse_bundle.v1",
  "type": "object",
  "required": [
    "repo_root",
    "writes",
    "deletes",
    "calls"
  ],
  "properties": {
    "repo_root": {
      "type": "string",
      "minLength": 1
    },
    "writes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "contents"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "contents": {
            "type": "string"
          },
          "expected_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "create": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "deletes": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "required": [
              "path",
              "expected_digest"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "expected_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "calls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
