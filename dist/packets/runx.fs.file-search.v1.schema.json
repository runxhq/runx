{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/fs/file_search/v1.json",
  "x-runx-packet-id": "runx.fs.file_search.v1",
  "type": "object",
  "required": [
    "repo_root",
    "matches",
    "files_searched",
    "truncated"
  ],
  "properties": {
    "repo_root": {
      "type": "string",
      "minLength": 1
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "line",
          "text",
          "before",
          "after",
          "content_digest"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string"
          },
          "before": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 3
          },
          "after": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 3
          },
          "content_digest": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "files_searched": {
      "type": "integer",
      "minimum": 0
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
