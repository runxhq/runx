{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/support/triage_reply/v1.json",
  "x-runx-packet-id": "runx.support.triage_reply.v1",
  "x-runx-generated-from": "skills/helpdesk/run.yaml#root.runners.triage.steps.0",
  "type": "object",
  "required": [
    "classification",
    "confidence",
    "draft_email",
    "evidence",
    "recommended_path",
    "send_gate",
    "severity"
  ],
  "properties": {
    "classification": {
      "type": "string"
    },
    "confidence": {
      "type": "number"
    },
    "draft_email": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "type": [
            "string",
            "null"
          ]
        },
        "proposed": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "recipient_hint": {
          "type": "string"
        },
        "subject": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "proposed",
        "subject",
        "body"
      ],
      "type": "object"
    },
    "evidence": {
      "additionalProperties": false,
      "properties": {
        "matched_signals": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "missing_context": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "private_data_required": {
          "type": "boolean"
        },
        "send_side_effects": {
          "const": "none"
        },
        "source": {
          "minLength": 1,
          "type": "string"
        },
        "source_summary": {
          "minLength": 1,
          "type": "string"
        },
        "taxonomy_coverage": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "source",
        "source_summary",
        "matched_signals",
        "missing_context",
        "taxonomy_coverage",
        "private_data_required",
        "send_side_effects"
      ],
      "type": "object"
    },
    "recommended_path": {
      "type": "string"
    },
    "send_gate": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "send_customer_email",
            "no_customer_send_proposed"
          ],
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "const": "requires_human_approval"
        }
      },
      "required": [
        "status",
        "action",
        "rationale"
      ],
      "type": "object"
    },
    "severity": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
