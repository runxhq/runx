{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/support/triage_reply/v1.json",
  "x-runx-packet-id": "runx.support.triage_reply.v1",
  "x-runx-generated-from": "skills/support-triage/run.yaml#root.runners.triage.steps.3",
  "additionalProperties": false,
  "properties": {
    "classification": {
      "enum": [
        "how_to",
        "billing",
        "account_access",
        "bug",
        "abuse",
        "unknown"
      ]
    },
    "context_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "decision": {
      "enum": [
        "ready",
        "held"
      ]
    },
    "delivery_status": {
      "const": "not_sent"
    },
    "draft_email": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "maxLength": 20000,
          "minLength": 1,
          "type": "string"
        },
        "subject": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "subject",
        "body"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "quote": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "source_ref": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "source_ref",
          "quote"
        ],
        "type": "object"
      },
      "maxItems": 50,
      "type": "array"
    },
    "missing_context": {
      "items": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 30,
      "type": "array"
    },
    "operator_notes": {
      "items": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 30,
      "type": "array"
    },
    "rationale": {
      "maxLength": 5000,
      "minLength": 1,
      "type": "string"
    },
    "recommended_path": {
      "enum": [
        "reply_draft",
        "request_info",
        "engineering_intake",
        "billing_review",
        "account_review",
        "abuse_review",
        "manual_review"
      ]
    },
    "request_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "runx.support.triage_reply.v1"
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "validation": {
      "additionalProperties": false,
      "properties": {
        "findings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        }
      },
      "required": [
        "status",
        "findings"
      ],
      "type": "object"
    }
  },
  "required": [
    "classification",
    "severity",
    "recommended_path",
    "rationale",
    "evidence",
    "missing_context",
    "operator_notes",
    "draft_email",
    "schema",
    "decision",
    "delivery_status",
    "request_digest",
    "context_digest",
    "validation"
  ],
  "type": "object"
}
