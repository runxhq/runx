{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/context/weather_forecast/v1.json",
  "x-runx-packet-id": "runx.context.weather_forecast.v1",
  "x-runx-generated-from": "skills/weather-forecast/run.yaml#root.runners.normalize.steps.1",
  "type": "object",
  "required": [
    "decision",
    "forecast_packet",
    "horizon",
    "location",
    "provider_evidence",
    "receipt_notes",
    "safety_notes",
    "stop_conditions"
  ],
  "properties": {
    "decision": {
      "type": "string"
    },
    "forecast_packet": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        },
        "hazards": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "periods": {
          "items": {
            "additionalProperties": true,
            "properties": {
              "forecast": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "wind": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "type": "array"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "summary",
        "periods",
        "hazards",
        "confidence",
        "generated_at"
      ],
      "type": "object"
    },
    "horizon": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "provider_evidence": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string"
        },
        "receipt_refs": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "provider",
        "source_refs",
        "receipt_refs"
      ],
      "type": "object"
    },
    "receipt_notes": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "const": "context-only"
        },
        "mutation": {
          "const": false
        }
      },
      "required": [
        "authority",
        "mutation"
      ],
      "type": "object"
    },
    "safety_notes": {
      "type": "array"
    },
    "stop_conditions": {
      "type": "array"
    }
  },
  "additionalProperties": false
}
