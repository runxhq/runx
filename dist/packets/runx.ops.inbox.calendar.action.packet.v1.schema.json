{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/ops/inbox_calendar_action_packet/v1.json",
  "x-runx-packet-id": "runx.ops.inbox_calendar_action_packet.v1",
  "x-runx-generated-from": "skills/chief-of-staff/run.yaml#root.runners.exec.steps.1",
  "additionalProperties": false,
  "properties": {
    "calendar_mutated": {
      "const": false
    },
    "decision": {
      "enum": [
        "ready_for_human_review",
        "manual_review",
        "needs_context"
      ],
      "type": "string"
    },
    "delivery_status": {
      "const": "not_sent"
    },
    "draft_replies": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "body_summary": {
            "maxLength": 10000,
            "minLength": 1,
            "type": "string"
          },
          "source_ref": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "subject": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "source_ref",
          "subject",
          "body_summary"
        ],
        "type": "object"
      },
      "maxItems": 200,
      "type": "array"
    },
    "mandatory_review_refs": {
      "items": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 200,
      "type": "array",
      "uniqueItems": true
    },
    "priority_queue": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "priority": {
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "type": "string"
          },
          "reason": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "source_ref": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "source_ref",
          "priority",
          "reason"
        ],
        "type": "object"
      },
      "maxItems": 200,
      "type": "array"
    },
    "risks": {
      "items": {
        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 200,
      "type": "array"
    },
    "scheduling_proposals": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "proposed_times": {
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 50,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "source_ref": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "source_ref",
          "proposed_times"
        ],
        "type": "object"
      },
      "maxItems": 200,
      "type": "array"
    },
    "source_evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "thread",
              "event",
              "availability"
            ],
            "type": "string"
          },
          "observed_at": {
            "format": "date-time",
            "type": "string"
          },
          "provenance": {
            "const": "caller_supplied_source_digest"
          },
          "sensitivity": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "source_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "source_ref": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "source_ref",
          "source_digest",
          "kind",
          "sensitivity",
          "observed_at",
          "provenance"
        ],
        "type": "object"
      },
      "maxItems": 201,
      "type": "array"
    },
    "validation": {
      "additionalProperties": false,
      "properties": {
        "findings": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "message": {
                "maxLength": 4000,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          },
          "maxItems": 250,
          "type": "array"
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ],
          "type": "string"
        }
      },
      "required": [
        "status",
        "findings"
      ],
      "type": "object"
    }
  },
  "required": [
    "decision",
    "priority_queue",
    "draft_replies",
    "scheduling_proposals",
    "risks",
    "source_evidence",
    "mandatory_review_refs",
    "delivery_status",
    "calendar_mutated",
    "validation"
  ],
  "type": "object"
}
