{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/agency/turn/v1.json",
  "x-runx-packet-id": "runx.agency.turn.v1",
  "x-runx-generated-from": "skills/agency/graph/plan/run.yaml#root.runners.default.steps.0",
  "type": "object",
  "required": [
    "agency_turn",
    "expected_version",
    "idempotency_key",
    "turn_event"
  ],
  "properties": {
    "agency_turn": {
      "additionalProperties": false,
      "properties": {
        "approval_prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "case_id": {
          "minLength": 1,
          "type": "string"
        },
        "dispatch": {
          "additionalProperties": true,
          "type": [
            "object",
            "null"
          ]
        },
        "next": {
          "minLength": 1,
          "type": "string"
        },
        "predicates": {
          "additionalProperties": {
            "type": "boolean"
          },
          "type": "object"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolution": {
          "additionalProperties": true,
          "type": [
            "object",
            "null"
          ]
        },
        "schema": {
          "const": "runx.agency.turn.v1"
        },
        "status": {
          "enum": [
            "advanced",
            "awaiting_approval",
            "resolved",
            "failed"
          ],
          "type": "string"
        },
        "turn": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "schema",
        "status",
        "case_id",
        "turn",
        "dispatch",
        "approval_prompt",
        "resolution",
        "predicates",
        "reason",
        "next"
      ],
      "type": "object"
    },
    "expected_version": {
      "type": "integer"
    },
    "idempotency_key": {
      "type": "string"
    },
    "turn_event": {
      "additionalProperties": false,
      "properties": {
        "payload": {
          "additionalProperties": false,
          "properties": {
            "decision": {
              "enum": [
                "dispatch",
                "escalate",
                "done",
                "failed"
              ],
              "type": "string"
            },
            "dispatch": {
              "additionalProperties": true,
              "type": [
                "object",
                "null"
              ]
            },
            "driver_id": {
              "minLength": 1,
              "type": "string"
            },
            "escalation": {
              "additionalProperties": false,
              "properties": {
                "approval_prompt": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "ask": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "trigger": {
                  "type": "string"
                }
              },
              "type": [
                "object",
                "null"
              ]
            },
            "member_result": {
              "additionalProperties": true,
              "type": [
                "object",
                "null"
              ]
            },
            "predicates": {
              "additionalProperties": {
                "type": "boolean"
              },
              "type": "object"
            },
            "resolution": {
              "additionalProperties": true,
              "type": [
                "object",
                "null"
              ]
            },
            "turn": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "driver_id",
            "turn",
            "decision",
            "predicates"
          ],
          "type": "object"
        },
        "type": {
          "const": "turn"
        }
      },
      "required": [
        "type",
        "payload"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false
}
