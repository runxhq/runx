{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/payment/dispute_response/v1.json",
  "x-runx-packet-id": "runx.payment.dispute_response.v1",
  "x-runx-generated-from": "skills/dispute-respond/run.yaml#root.runners.respond.steps.3",
  "additionalProperties": false,
  "properties": {
    "decision": {
      "enum": [
        "ready_for_review",
        "needs_more_evidence"
      ],
      "type": "string"
    },
    "dispute": {
      "additionalProperties": false,
      "properties": {
        "amount_minor": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "currency": {
          "pattern": "^(?:[A-Z]{3})?$",
          "type": "string"
        },
        "dispute_id": {
          "maxLength": 256,
          "type": "string"
        },
        "provider": {
          "maxLength": 64,
          "type": "string"
        },
        "provider_charge_ref": {
          "maxLength": 256,
          "type": "string"
        },
        "reason_code": {
          "maxLength": 128,
          "type": "string"
        },
        "response_due_at": {
          "maxLength": 64,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "dispute_id",
        "provider",
        "provider_charge_ref",
        "amount_minor",
        "currency",
        "reason_code",
        "response_due_at"
      ],
      "type": "object"
    },
    "evidence": {
      "additionalProperties": false,
      "properties": {
        "admitted": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "digest": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              "kind": {
                "enum": [
                  "delivery",
                  "consent",
                  "support",
                  "provider",
                  "contract",
                  "refund"
                ],
                "type": "string"
              },
              "ref": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              "summary": {
                "maxLength": 1000,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "ref",
              "digest",
              "kind",
              "summary"
            ],
            "type": "object"
          },
          "maxItems": 100,
          "type": "array"
        },
        "cited_refs": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "admitted",
        "cited_refs"
      ],
      "type": "object"
    },
    "filing": {
      "additionalProperties": false,
      "properties": {
        "approval_status": {
          "const": "not_requested"
        },
        "dispute_id": {
          "maxLength": 256,
          "type": "string"
        },
        "provider": {
          "maxLength": 64,
          "type": "string"
        },
        "provider_status": {
          "const": "not_called"
        },
        "status": {
          "const": "not_filed"
        }
      },
      "required": [
        "provider",
        "dispute_id",
        "status",
        "provider_status",
        "approval_status"
      ],
      "type": "object"
    },
    "linked_receipts": {
      "additionalProperties": false,
      "properties": {
        "cited": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 101,
          "type": "array",
          "uniqueItems": true
        },
        "original_charge": {
          "maxLength": 256,
          "type": "string"
        },
        "prior_refunds": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "original_charge",
        "prior_refunds",
        "cited"
      ],
      "type": "object"
    },
    "next_action": {
      "maxLength": 4000,
      "minLength": 1,
      "type": "string"
    },
    "open_questions": {
      "items": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "type": "array"
    },
    "posture": {
      "enum": [
        "accept",
        "contest",
        "refund_already_sent",
        "needs_more_evidence",
        "operator_review"
      ],
      "type": "string"
    },
    "receipt_verification": {
      "additionalProperties": false,
      "properties": {
        "issuer_types": {
          "items": {
            "enum": [
              "local",
              "hosted",
              "ci"
            ],
            "type": "string"
          },
          "maxItems": 101,
          "type": "array"
        },
        "matched_receipt_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 101,
          "type": "array",
          "uniqueItems": true
        },
        "original_receipt_status": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "tree_status": {
          "enum": [
            "intact",
            "unverified"
          ],
          "type": "string"
        }
      },
      "required": [
        "matched_receipt_ids",
        "original_receipt_status",
        "issuer_types",
        "tree_status"
      ],
      "type": "object"
    },
    "response_summary": {
      "maxLength": 10000,
      "type": "string"
    },
    "schema": {
      "const": "runx.payment.dispute_response.v1"
    },
    "validation": {
      "additionalProperties": false,
      "properties": {
        "findings": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "message": {
                "maxLength": 4000,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          },
          "maxItems": 500,
          "type": "array"
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ],
          "type": "string"
        }
      },
      "required": [
        "status",
        "findings"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema",
    "decision",
    "dispute",
    "posture",
    "response_summary",
    "linked_receipts",
    "evidence",
    "open_questions",
    "receipt_verification",
    "validation",
    "filing",
    "next_action"
  ],
  "type": "object"
}
