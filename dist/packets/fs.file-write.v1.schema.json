{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/fs/file-write/v1.json",
  "x-runx-packet-id": "runx.fs.file_write.v1",
  "type": "object",
  "required": ["path", "repo_root", "bytes_written", "sha256", "diff"],
  "properties": {
    "path": { "type": "string", "minLength": 1 },
    "repo_root": { "type": "string", "minLength": 1 },
    "bytes_written": { "type": "integer", "minimum": 0 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "before_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "diff": { "type": "string", "description": "The unified diff from what the file held to what the change left; empty when it left the file as it was." },
    "journal": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}
