{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/growth/lead_route/v1.json",
  "x-runx-packet-id": "runx.growth.lead_route.v1",
  "x-runx-generated-from": "skills/lead-router/run.yaml#root.runners.lead-router.steps.2",
  "additionalProperties": false,
  "properties": {
    "decision": {
      "enum": [
        "ready",
        "needs_more_evidence"
      ],
      "type": "string"
    },
    "delivery_status": {
      "const": "not_sent"
    },
    "downstream_handoff": {
      "additionalProperties": false,
      "properties": {
        "expected_outcome": {
          "const": "content_and_provider_preflight_required"
        },
        "inputs": {
          "additionalProperties": false,
          "properties": {
            "audience": {
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "maxLength": 1000,
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "segment",
                    "recipient"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "type",
                "ref"
              ],
              "type": "object"
            },
            "consent_basis": {
              "maxLength": 2000,
              "type": "string"
            },
            "objective": {
              "maxLength": 4000,
              "type": "string"
            },
            "operator_context": {
              "maxLength": 4000,
              "type": "string"
            },
            "principal": {
              "maxLength": 1000,
              "type": "string"
            },
            "provider_context": {
              "maxProperties": 100,
              "type": "object"
            }
          },
          "required": [
            "principal",
            "objective",
            "provider_context",
            "audience",
            "consent_basis",
            "operator_context"
          ],
          "type": "object"
        },
        "runner": {
          "const": "plan"
        },
        "skill": {
          "const": "send-as"
        },
        "state": {
          "const": "prepared_for_send_planning"
        }
      },
      "type": "object"
    },
    "enrichment_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "hold_record": {
      "additionalProperties": false,
      "properties": {
        "external_state_mutated": {
          "const": false
        },
        "reason": {
          "maxLength": 1000,
          "type": "string"
        },
        "record_scope": {
          "enum": [
            "signed_run_receipt",
            "none"
          ],
          "type": "string"
        },
        "recorded": {
          "type": "boolean"
        }
      },
      "required": [
        "recorded",
        "record_scope",
        "external_state_mutated",
        "reason"
      ],
      "type": "object"
    },
    "rationale": {
      "maxLength": 4000,
      "type": "string"
    },
    "route": {
      "enum": [
        "reach_out",
        "nurture",
        "hold"
      ],
      "type": "string"
    },
    "segment": {
      "maxLength": 1000,
      "type": "string"
    },
    "validation": {
      "additionalProperties": false,
      "properties": {
        "findings": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "message": {
                "maxLength": 4000,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          },
          "maxItems": 250,
          "type": "array"
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ],
          "type": "string"
        }
      },
      "required": [
        "status",
        "findings"
      ],
      "type": "object"
    }
  },
  "required": [
    "decision",
    "route",
    "rationale",
    "segment",
    "evidence_refs",
    "enrichment_digest",
    "downstream_handoff",
    "hold_record",
    "delivery_status",
    "validation"
  ],
  "type": "object"
}
