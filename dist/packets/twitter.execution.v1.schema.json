{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/twitter/execution/v1.json",
  "x-runx-packet-id": "twitter.execution.v1",
  "x-runx-generated-from": "skills/twitter/X.yaml#root.runners.execute.graph.steps.6",
