        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 250,
      "type": "array"
    },
    "decision": {
      "enum": [
        "executed",
        "partial",
        "stopped",
        "refused",
        "noop"
      ],
      "type": "string"
    },
    "ledger_delta": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "pattern": "^[0-9]{1,19}$",
          "type": "string"
        },
        "active_thread": {
          "maxProperties": 3,
          "type": [
            "object",
            "null"
          ]
        },
        "batch": {
          "additionalProperties": false,
          "properties": {
            "completed_act_count": {
              "maximum": 50,
              "minimum": 0,
              "type": "integer"
            },
            "failed": {
              "type": "boolean"
            },
            "rate_limited": {
              "type": "boolean"
            },
            "selected_act_count": {
              "maximum": 50,
              "minimum": 0,
              "type": "integer"
            },
            "start_act_index": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "start_act_index",
            "selected_act_count",
            "completed_act_count",
            "failed",
            "rate_limited"
          ],
          "type": "object"
        },
        "decision": {
          "enum": [
            "executed",
            "partial",
            "stopped"
          ],
          "type": "string"
        },
        "next_act_index": {
          "minimum": 0,
          "type": "integer"
        },
        "plan_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "schema": {
          "const": "twitter.execution.progress.v1"
        },
        "total_act_count": {
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "twitter.execution.progress"
        }
      },
      "required": [
        "schema",
        "type",
        "plan_digest",
        "account_id",
        "decision",
        "next_act_index",
        "total_act_count",
        "active_thread",
        "batch"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "next_act_index": {
      "minimum": 0,
      "type": "integer"
    },
    "plan_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "principal": {
      "maxLength": 1000,
      "type": [
        "string",
        "null"
      ]
    },
    "rate": {
      "additionalProperties": false,
      "properties": {
        "limited": {
          "type": "boolean"
        },
        "remaining": {
          "type": "number"
        },
        "reset_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "limited",
        "remaining",
        "reset_at"
      ],
      "type": "object"
    },
    "remaining_count": {
      "minimum": 0,
      "type": "integer"
    },
    "results": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "act_id": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "consequence": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "detail": {
            "maxLength": 4000,
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "provider_ref": {
            "maxLength": 4000,
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
