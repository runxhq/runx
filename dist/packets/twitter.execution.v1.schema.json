    "success_checkpoint": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        "milestone": {
          "enum": [
            "plan_fully_executed",
            "plan_partially_executed",
            "plan_refused"
