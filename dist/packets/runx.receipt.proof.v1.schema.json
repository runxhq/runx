{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/receipt/proof/v1.json",
  "x-runx-packet-id": "runx.receipt.proof.v1",
  "type": "object",
  "required": ["schema", "decision", "requested_receipt_ids", "matched_receipts", "receipt_details", "verification", "store"],
  "properties": {
    "schema": { "const": "runx.receipt.proof.v1" },
    "decision": { "enum": ["verified", "needs_more_evidence"] },
    "requested_receipt_ids": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "minLength": 1 } },
    "matched_receipts": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/receiptStub" } },
    "receipt_details": { "type": "array", "maxItems": 100, "items": { "type": "object", "additionalProperties": true } },
    "verification": { "$ref": "#/$defs/verification" },
    "store": {
      "type": "object",
      "required": ["label"],
      "properties": { "label": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    }
  },
  "$defs": {
    "receiptStub": {
      "type": "object",
      "required": ["receipt_id", "skill_ref", "status", "created_at", "verification_status"],
      "properties": {
        "receipt_id": { "type": "string", "minLength": 1 },
        "skill_ref": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "minLength": 1 },
        "verification_status": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["checked", "intact", "trees", "findings"],
      "properties": {
        "checked": { "type": "boolean" },
        "intact": { "type": "boolean" },
        "trees": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "findings": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
