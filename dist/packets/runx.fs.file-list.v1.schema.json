{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/fs/file_list/v1.json",
  "x-runx-packet-id": "runx.fs.file_list.v1",
  "type": "object",
  "required": [
    "repo_root",
    "path",
    "entries",
    "truncated"
  ],
  "properties": {
    "repo_root": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "directory",
              "symlink"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "maxItems": 5000
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
