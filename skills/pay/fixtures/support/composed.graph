name: pay-composed
steps:
  - id: pay
    skill: ../..
    runner: pay
    inputs:
      connector: wallet/evm
      request:
        resource:
          url: https://merchant.example/v1/report
          method: POST
          body:
            offer_id: document-ocr
            input:
              artifact_uri: runx:artifact:document-1
          max_response_bytes: 26214400
        amount_minor: 25
        pay_to: "0x0000000000000000000000000000000000000002"
      parent_payment_authority:
        term_id: authority-test-1
        currency: USD
        max_amount_minor: 25
        resource_url: https://merchant.example/v1/report
      idempotency_seed: pay-test-payment-001
  - id: digest
    tool: data.digest
    inputs:
      value: $steps.pay
