name: least-privilege-composed
steps:
  - id: least-privilege
    skill: ../..
    runner: audit
    inputs:
      subject: research/research-brief
      granted_scopes:
        - web:read
        - repo:read
      receipt_ids: []
      receipt_rows: []
      objective: Audit a newly published skill with no runs.
  - id: digest
    tool: data.digest
    inputs:
      value: $steps.least-privilege
