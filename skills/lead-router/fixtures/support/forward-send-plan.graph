name: lead-router-forward-send-plan
steps:
  - id: route
    skill: ../..
    runner: lead-router
    inputs:
      enrichment_packet:
        decision: ready_for_review
        lead_profile: { account_id: acct_42, company: ExampleCRM }
        evidence:
          - { claim: Active evaluation., source_refs: [signal_pricing], confidence: observed }
        fit_assessment: { fit: strong, confidence: medium }
        recommended_action: { type: review_outreach }
        signal_evidence:
          - { source_ref: signal_pricing, signal_digest: sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, type: product, observed_at: "2026-07-16T10:00:00Z" }
        consent: { opted_in: true, do_not_contact: false, channels_allowed: [email] }
        delivery_status: not_sent
        validation: { status: pass, findings: [] }
      principal: account:growth-bot
      objective: Offer a deliverability review.
      provider_context: { provider: example-email, account_ref: provider-account:growth, runtime_path: email.send }
  - id: send-plan
    skill: ../../../send-as
    runner: plan
    inputs:
      principal: $steps.route.lead_route_packet.data.downstream_handoff.inputs.principal
      objective: $steps.route.lead_route_packet.data.downstream_handoff.inputs.objective
      provider_context: $steps.route.lead_route_packet.data.downstream_handoff.inputs.provider_context
      audience: $steps.route.lead_route_packet.data.downstream_handoff.inputs.audience
      consent_basis: $steps.route.lead_route_packet.data.downstream_handoff.inputs.consent_basis
      operator_context: $steps.route.lead_route_packet.data.downstream_handoff.inputs.operator_context
