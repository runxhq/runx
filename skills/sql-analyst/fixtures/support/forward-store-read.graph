name: sql-analyst-forward-store-read
steps:
  - id: analyze
    skill: ../..
    inputs:
      question: Inspect the declared launch summary projection.
      dialect: sqlite
      as_of: "2026-07-17T12:00:00Z"
      schema_summary:
        source_ref: schema:launch-summary:v1
        source_digest: sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
        observed_at: "2026-07-17T10:00:00Z"
        tables:
          launch_metrics:
            fields: [account_id, qualified_trials, observed_at]
      constraints: { allowed_tables: [launch_metrics], read_only: true, max_rows: 1 }
      execution_context:
        operation: projection.read
        data_source_ref: local://runx/sql-analyst/forward-read
        resource: analysis_snapshots
        aggregate_id: launch-summary
