name: spend-composed
steps:
  - id: spend
    skill: ../..
    runner: spend
    inputs:
      payment_signal: { amount_minor: 125, currency: USD, counterparty: "merchant:demo" }
      parent_payment_authority: { term_id: "authority:test" }
      rail: mpp
      rail_profile_ref: "rail-profile:test"
      idempotency_seed: spend-test-001
  - id: digest
    tool: data.digest
    inputs:
      value: $steps.spend
