{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/packages/runx/vuln-triage/scan/v1.json",
  "x-runx-packet-id": "runx/vuln-triage.scan.v1",
  "type": "object",
  "required": [
    "schema",
    "decision",
    "target",
    "advisories",
    "escalation_criteria",
    "remediation_plan",
    "operator_summary",
    "evidence_binding",
    "validation",
    "publication_status",
    "exposure_evidence"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "runx/vuln-triage.scan.v1"
    },
    "decision": {
      "type": "string",
      "enum": [
        "no_matches_in_scope",
        "needs_more_evidence",
        "remediate",
        "monitor",
        "needs_human"
      ]
    },
    "target": {
      "type": "string"
    },
    "advisories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "escalation_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_key",
          "advisory_id",
          "trigger",
          "action"
        ],
        "properties": {
          "finding_key": {
            "type": "string"
          },
          "advisory_id": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          },
          "action": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "remediation_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_key",
          "recommendation",
          "fixed_version"
        ],
        "properties": {
          "finding_key": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "fixed_version": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "operator_summary": {
      "type": "object",
      "additionalProperties": true
    },
    "evidence_binding": {
      "type": "object",
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "required": [
        "status",
        "findings"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "publication_status": {
      "type": "string",
      "const": "not_published"
    },
    "exposure_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
