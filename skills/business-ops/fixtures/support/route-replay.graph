name: business-ops-route-replay
owner: runx
steps:
  - id: classify
    skill: ../../graph/ops-lane
    inputs:
      lane: classify
      signal: Replay one launch-readiness route without duplicating its durable event.
      operator_context: Harness-only local SQLite state; no provider or public effect.
  - id: persist-route
    skill: ../../../data-store
    runner: append_event
    inputs:
      data_source_ref: tenant://business-ops/replay-routes
      resource: ops_routes
      aggregate_id: launch-readiness-replay
      expected_version: 0
      idempotency_key: launch-readiness-replay:classify:v1
      event: $steps.classify.lane_packet.data
  - id: replay-route
    skill: ../../../data-store
    runner: append_event
    inputs:
      data_source_ref: tenant://business-ops/replay-routes
      resource: ops_routes
      aggregate_id: launch-readiness-replay
      expected_version: 0
      idempotency_key: launch-readiness-replay:classify:v1
      event: $steps.classify.lane_packet.data
  - id: readback
    skill: ../../../data-store
    runner: read_projection
    inputs:
      data_source_ref: tenant://business-ops/replay-routes
      resource: ops_routes
      aggregate_id: launch-readiness-replay
