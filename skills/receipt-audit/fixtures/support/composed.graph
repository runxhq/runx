name: receipt-audit-composed
steps:
  - id: receipt-audit
    skill: ../..
    runner: audit
    inputs:
      receipt_id: rcpt_issue_triage_4471
      receipt_rows:
        - receipt_id: rcpt_issue_triage_4471
          skill: github-issue-triage
          outcome: completed
          created_at: "2026-07-16T00:00:00Z"
          verification_status: verified
      receipt_details:
        - id: rcpt_issue_triage_4471
          receipt_uri: runx:receipt:rcpt_issue_triage_4471
          subject_kind: graph
          subject_uri: github-issue-triage
          created_at: "2026-07-16T00:00:00Z"
          outcome: completed
          verification:
            status: verified
          authority:
            actor_uri: runx:principal:operator
            grant_uris:
              - runx:grant:repo-read
            scope_uris:
              - runx:scope_admission:repo.read
            exercised_scopes:
              - scope: repo:read
                source: scope_ref
                term_id: null
                resource_uri: runx:scope_admission:repo.read
            approval_uris: []
            term_count: 0
            credential_ref_count: 0
          decisions: []
          acts:
            - id: act_read
              form: observation
              purpose: Read the issue thread.
              legitimacy: Held repo.read.
              target_uris: []
              artifact_uris: []
              criterion_statuses: []
              context_ref_present: false
          artifact_uris: []
          lineage_uris: []
      granted_scopes:
        - repo:read
      objective: Confirm the triage run stayed within its read-only grant.
  - id: digest
    tool: data.digest
    inputs:
      value: $steps.receipt-audit
