name: receipt-audit-composed
steps:
  - id: receipt-audit
    skill: ../..
    runner: audit
    inputs:
      receipt_id: rcpt_issue_triage_4471
      receipt_rows:
        - receipt_id: rcpt_issue_triage_4471
          skill_ref: issue-triage
          status: closed
          created_at: "2026-07-16T00:00:00Z"
          verification_status: verified
      receipt_details:
        - id: rcpt_issue_triage_4471
          receipt_ref: runx:receipt:rcpt_issue_triage_4471
          subject_kind: graph
          subject_ref: issue-triage
          created_at: "2026-07-16T00:00:00Z"
          status: closed
          verification:
            status: verified
          authority:
            actor_ref: runx:principal:operator
            grant_refs:
              - runx:grant:repo-read
            scope_refs:
              - runx:scope_admission:repo.read
            exercised_scopes:
              - scope: repo:read
                source: scope_ref
                term_id: null
                resource_ref: runx:scope_admission:repo.read
            approval_refs: []
            term_count: 0
            credential_ref_count: 0
          decisions: []
          acts:
            - id: act_read
              form: observation
              purpose: Read the issue thread.
              legitimacy: Held repo.read.
              target_refs: []
              artifact_refs: []
              criterion_statuses: []
              context_ref_present: false
          artifact_refs: []
          lineage_refs: []
      granted_scopes:
        - repo:read
      objective: Confirm the triage run stayed within its read-only grant.
  - id: digest
    tool: data.digest
    inputs:
      value: $steps.receipt-audit
