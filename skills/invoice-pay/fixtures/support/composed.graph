name: invoice-pay-composed
steps:
  - id: invoice-pay
    skill: ../..
    runner: invoice-pay
    inputs:
      invoice_ref: INV-2026-0042
      amount_minor: 4200
      currency: USD
      payee:
        payment_url: https://payee.example/v1/invoices/pay
      parent_payment_authority:
        term_id: invoice-authority-1
        currency: USD
        max_amount_minor: 5000
        counterparty: https://payee.example/v1/invoices/pay
      idempotency_seed: invoice-pay-test-0042
      connector: wallet/evm
      request:
        resource:
          url: https://payee.example/v1/invoices/pay
          method: POST
          body:
            invoice_ref: INV-2026-0042
        amount_minor: 4200
        pay_to: "0x00000000000000000000000000000000000000a1"
  - id: digest
    tool: data.digest
    inputs:
      value: $steps.invoice-pay
