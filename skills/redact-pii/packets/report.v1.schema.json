{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/packages/runx/redact-pii/report/v1.json",
  "x-runx-packet-id": "runx/redact-pii.report.v1",
  "type": "object",
  "required": [
    "decision",
    "detected",
    "source_digest",
    "redacted_digest",
    "residual_risk",
    "scanner",
    "policy"
  ],
  "properties": {
    "decision": { "type": "string", "enum": ["ready", "needs_review", "blocked"] },
    "detected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "span", "confidence"],
        "properties": {
          "class": { "type": "string", "minLength": 1 },
          "span": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 },
            "minItems": 2,
            "maxItems": 2
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    },
    "source_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "redacted_digest": {
      "anyOf": [
        { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        { "type": "null" }
      ]
    },
    "residual_risk": {
      "type": "object",
      "required": ["level", "reason_code", "reason"],
      "properties": {
        "level": { "type": "string", "enum": ["low", "medium", "high"] },
        "reason_code": { "type": "string", "minLength": 1 },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "scanner": {
      "type": "object",
      "required": ["status", "findings"],
      "properties": {
        "status": { "type": "string", "enum": ["pass", "hold", "block"] },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "message": { "type": "string", "minLength": 1 },
              "path": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["classes", "mode", "locale"],
      "properties": {
        "classes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "mode": { "type": "string", "enum": ["redact", "tokenize", "block"] },
        "locale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "decision": { "const": "ready" } },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "redacted_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "scanner": {
            "type": "object",
            "properties": { "status": { "const": "pass" } }
          }
        }
      },
      "else": { "properties": { "redacted_digest": { "type": "null" } } }
    }
  ],
  "additionalProperties": false
}
