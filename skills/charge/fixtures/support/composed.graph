name: charge-composed
steps:
  - id: charge
    skill: ../..
    runner: charge
    inputs:
      resource: https://seller.example/v1/reports/launch
      amount_minor: 125
      currency: USD
      payment_payload: { x402Version: 2, scheme: exact, network: "eip155:8453", payload: { signature: "0xsigned" } }
      payment_requirements: { scheme: exact, network: "eip155:8453", amount: "1250000", payTo: "0x0000000000000000000000000000000000000002" }
      request_binding_digest: "sha256:3333333333333333333333333333333333333333333333333333333333333333"
      idempotency_seed: charge-test-0000001
  - id: digest
    tool: data.digest
    inputs:
      value: $steps.charge
