name: ghostwrite-composed
steps:
  - id: ghostwrite
    skill: ../..
    runner: draft
    inputs:
      objective: Explain the strongest Runx architecture signal.
      audience: operators
      channel: brief
      evidence_pack:
        decision: ready
        research_brief:
          objective: Explain the strongest Runx architecture signal.
          scope: Runx receipt architecture.
          summary: Receipts bind actions to authority evidence.
          open_questions: []
        evidence_log:
          - claim: Receipts bind actions to authority evidence.
            source_digest: sha256:1111111111111111111111111111111111111111111111111111111111111111
            content_digest: sha256:1111111111111111111111111111111111111111111111111111111111111111
            confidence: verified
            relevance: Directly supports the requested architecture signal.
        decision_support: []
        risks: []
        source_evidence:
          - evidence_digest: sha256:1111111111111111111111111111111111111111111111111111111111111111
            content_digest: sha256:1111111111111111111111111111111111111111111111111111111111111111
            source_ref: local://runx/receipt-architecture
            source_kind: local_file
            provenance: { path: docs/receipt-architecture.md }
        index_digest: sha256:1111111111111111111111111111111111111111111111111111111111111111
        validation: { status: pass, findings: [] }
      brand_context:
        decision: ready
        brand: Runx
        applicability: { channels: [brief], audience: operators, boundaries: [Do not extend claims beyond admitted evidence.] }
        brand_voice:
          voice_principles: [Lead with governed action and proof.]
          vocabulary: { use: [receipt], avoid: [magic] }
          cadence: [Concise engineering sentences.]
          claim_rules: { safe: [Receipts bind actions to authority evidence.], forbidden: [], requires_proof: [] }
          channel_adjustments: []
        evidence:
          evidence_digest: sha256:4444444444444444444444444444444444444444444444444444444444444444
          sources:
            - { source_ref: "source:1", kind: approved, label: Approved Runx engineering note. }
          bindings:
            - { rule: Lead with governed action and proof., source_refs: ["source:1"] }
            - { rule: receipt, source_refs: ["source:1"] }
            - { rule: magic, source_refs: ["source:1"] }
            - { rule: Concise engineering sentences., source_refs: ["source:1"] }
            - { rule: Receipts bind actions to authority evidence., source_refs: ["source:1"] }
        redactions: []
        stop_conditions: []
        receipt_notes: { authority: context-only, mutation: false }
        validation: { status: pass, findings: [] }
      taste_context:
        decision: ready
        subject: Runx operators
        applicability: { surfaces: [brief], audience: operators, expires_when: [The evidence set changes materially.] }
        taste_profile:
          principles: [Make the workflow visible.]
          likes: [Dense operational surfaces.]
          dislikes: [Decorative filler.]
          decision_rules: [Choose operational clarity.]
          examples_to_emulate: []
          examples_to_avoid: []
        evidence:
          evidence_digest: sha256:4444444444444444444444444444444444444444444444444444444444444444
          sources:
            - { source_ref: "source:1", kind: liked, label: Operator-approved surface. }
          bindings:
            - { rule: Make the workflow visible., source_refs: ["source:1"], confidence: explicit }
            - { rule: Dense operational surfaces., source_refs: ["source:1"], confidence: explicit }
            - { rule: Decorative filler., source_refs: ["source:1"], confidence: explicit }
            - { rule: Choose operational clarity., source_refs: ["source:1"], confidence: explicit }
        redactions: []
        stop_conditions: []
        receipt_notes: { authority: context-only, mutation: false }
        validation: { status: pass, findings: [] }
  - id: digest
    tool: data.digest
    inputs:
      value: $steps.ghostwrite
