name: x402-pay-composed
steps:
  - id: x402-pay
    skill: ../..
    runner: pay
    inputs:
      payment_signal:
        resource:
          url: https://vendor.example/v1/invocations
          method: POST
          body: { offer_id: document-ocr, input: { artifact_ref: "runx:artifact:document-1" } }
          max_response_bytes: 26214400
        amount_minor: 25
        pay_to: "0x0000000000000000000000000000000000000002"
        parent_binding: current_paid_invocation
      parent_payment_authority:
        term_id: authority-test-1
        currency: USD
        max_amount_minor: 25
        counterparty: https://vendor.example/v1/invocations
      idempotency_seed: x402-test-payment-001
  - id: digest
    tool: data.digest
    inputs:
      value: $steps.x402-pay
