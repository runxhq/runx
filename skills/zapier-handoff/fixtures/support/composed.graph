name: zapier-handoff-composed
steps:
  - id: zapier-handoff
    skill: ../..
    runner: preflight
    inputs:
      event_id: evt_zapier_demo_001
      handoff_audience: zapier:zap:runx-governed-effect
      execution_context:
        caller: runx-cli
        workflow_ref: operator-zap-demo
        environment: local-dogfood
      payload:
        hello: zap
  - id: digest
    tool: data.digest
    inputs:
      value: $steps.zapier-handoff
