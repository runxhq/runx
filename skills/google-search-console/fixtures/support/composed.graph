name: google-search-console-composed
steps:
  - id: google-search-console
    skill: ../..
    runner: normalize-performance
    inputs:
      request:
        property: https://example.com/
        start_date: "2026-06-01"
        end_date: "2026-06-30"
        dimensions: [page]
        search_type: web
        data_state: final
      provider_result:
        property: https://example.com/
        start_date: "2026-06-01"
        end_date: "2026-06-30"
        dimensions: [page]
        search_type: web
        data_state: final
        aggregation_type: byPage
        rows:
          - keys: [https://example.com/guides/runx]
            clicks: 42
            impressions: 600
            ctr: 0.07
            position: 4.2
        row_count: 1
        pagination: { complete: true, returned_rows: 1 }
        fetched_at: "2026-07-01T02:00:00Z"
  - id: digest
    tool: data.digest
    inputs:
      value: $steps.google-search-console
