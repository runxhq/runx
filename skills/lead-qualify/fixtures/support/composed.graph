name: lead-qualify-composed
steps:
  - id: lead-qualify
    skill: ../..
    runner: qualify
    inputs:
      enrichment_packet:
        decision: enriched
        subject: {ref: 'lead:example', kind: person}
        as_of: '2026-10-10T00:00:00Z'
        facts:
        - {field: company.industry, value: B2B software, source_refs: ['crm:lead']}
        missing_fields: []
        conflicts: []
        sources:
        - source_ref: crm:lead
          source_digest: sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
          observed_at: '2026-10-09T00:00:00Z'
          match_confidence: high
          provenance: caller_supplied_source_digest
        blockers: []
        acquisition: supplied_evidence
      criteria:
      - {id: industry, description: Works for a B2B software company., required: true}
      contact_eligibility:
        subject: {ref: 'lead:example', kind: person}
        status: unknown
        policy_ref: policy:outreach
        evidence_refs: ['policy:assessment']
  - id: digest
    tool: data.digest
    inputs:
      value: $steps.lead-qualify
