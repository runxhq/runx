name: deep-research-ecosystem-composed
steps:
  - id: ecosystem
    skill: ../..
    runner: ecosystem
    inputs:
      objective: Identify the strongest architectural signal in the supplied Runx evidence.
      audience: operators
      channel: brief
      domain: agent infrastructure
      as_of: "2026-07-17T12:00:00Z"
      max_age_hours: 24
      source_packets:
        - decision: ready
          final_url: https://example.com/receipts
          status: 200
          content_digest: sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
          extracted: Runx receipts bind operator actions to explicit authority and verification evidence.
          provenance:
            fetched_at: "2026-07-17T00:00:00Z"
            bytes: 82
            truncated: false
            redirects: []
        - decision: ready
          final_url: https://example.com/skills
          status: 200
          content_digest: sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
          extracted: Portable skill packages separate model judgment from deterministic provider operations.
          provenance:
            fetched_at: "2026-07-17T00:01:00Z"
            bytes: 85
            truncated: false
            redirects: []
  - id: digest
    tool: data.digest
    inputs:
      value: $steps.ecosystem
