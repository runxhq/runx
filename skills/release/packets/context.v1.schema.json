{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/packages/runx/release/context/v1.json",
  "x-runx-packet-id": "runx/release.context.v1",
  "additionalProperties": false,
  "properties": {
    "channel": {
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "type": "string"
    },
    "commands": {
      "additionalProperties": false,
      "patternProperties": {
        "^(prepare|publish|verify)$": {
          "additionalProperties": false,
          "properties": {
            "args": {
              "items": {
                "maxLength": 2000,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 63,
              "type": "array"
            },
            "command": {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            "command_digest": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "cwd": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "env": {
              "additionalProperties": false,
              "properties": {
                "RUNX_RELEASE_CHANNEL": {
                  "maxLength": 128,
                  "minLength": 1,
                  "type": "string"
                },
                "RUNX_RELEASE_PHASE": {
                  "enum": [
                    "prepare",
                    "publish",
                    "verify"
                  ],
                  "type": "string"
                },
                "RUNX_RELEASE_PROFILE_ID": {
                  "maxLength": 256,
                  "minLength": 1,
                  "type": "string"
                },
                "RUNX_RELEASE_VERSION": {
                  "maxLength": 128,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "RUNX_RELEASE_PHASE",
                "RUNX_RELEASE_VERSION",
                "RUNX_RELEASE_CHANNEL",
                "RUNX_RELEASE_PROFILE_ID"
              ],
              "type": "object"
            },
            "timeout_ms": {
              "maximum": 3600000,
              "minimum": 1000,
              "type": "integer"
            }
          },
          "required": [
            "command",
            "args",
            "cwd",
            "timeout_ms",
            "env"
          ],
          "type": "object"
        }
      },
      "propertyNames": {
        "enum": [
          "prepare",
          "publish",
          "verify"
        ]
      },
      "required": [
        "prepare",
        "publish",
        "verify"
      ],
      "type": "object"
    },
    "last_tag": {
      "maxLength": 256,
      "type": "string"
    },
    "operator_context": {
      "maxLength": 2000,
      "type": "string"
    },
    "profile_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "profile_id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "profile_path": {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
    },
    "project_root": {
      "maxLength": 4000,
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "runx/release.context.v1"
    },
    "version": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema",
    "profile_id",
    "profile_path",
    "profile_digest",
    "project_root",
    "channel",
    "version",
    "last_tag",
    "operator_context",
    "commands"
  ],
  "type": "object"
}
