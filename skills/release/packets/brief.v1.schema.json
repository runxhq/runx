{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/packages/runx/release/brief/v1.json",
  "x-runx-packet-id": "runx/release.brief.v1",
  "type": "object",
  "required": [
    "schema",
    "decision",
    "profile_id",
    "profile_digest",
    "profile_path",
    "channel",
    "version",
    "last_tag",
    "preparation",
    "release_notes",
    "publish_intent",
    "verification_intent",
    "findings",
    "proof_boundary"
  ],
  "properties": {
    "schema": { "type": "string", "const": "runx/release.brief.v1" },
    "decision": { "type": "string", "enum": ["ready_for_approval", "blocked", "needs_agent"] },
    "profile_id": { "type": "string", "minLength": 1 },
    "profile_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "profile_path": { "type": "string", "minLength": 1 },
    "channel": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "last_tag": { "type": "string" },
    "preparation": {
      "type": "object",
      "required": ["status", "command_digest", "evidence", "observed"],
      "properties": {
        "status": { "type": "string", "enum": ["ready", "failed"] },
        "command_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "evidence": { "type": "object", "additionalProperties": true },
        "observed": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "release_notes": {
      "type": "object",
      "required": ["headline", "summary", "changelog", "upgrade_guidance", "risks"],
      "properties": {
        "headline": { "type": "string" },
        "summary": { "type": "string" },
        "changelog": {
          "type": "object",
          "required": ["added", "fixed", "changed", "removed", "breaking"],
          "properties": {
            "added": { "type": "array", "items": { "type": "string" } },
            "fixed": { "type": "array", "items": { "type": "string" } },
            "changed": { "type": "array", "items": { "type": "string" } },
            "removed": { "type": "array", "items": { "type": "string" } },
            "breaking": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "upgrade_guidance": { "type": "string" },
        "risks": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "publish_intent": {
      "type": "object",
      "required": [
        "command_digest",
        "command",
        "args",
        "cwd",
        "timeout_ms",
        "env_names",
        "approval_status"
      ],
      "properties": {
        "command_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "command": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "cwd": { "type": "string", "minLength": 1 },
        "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
        "env_names": { "type": "array", "items": { "type": "string" } },
        "approval_status": { "type": "string", "const": "pending" }
      },
      "additionalProperties": false
    },
    "verification_intent": {
      "type": "object",
      "required": [
        "command_digest",
        "command",
        "args",
        "cwd",
        "timeout_ms",
        "env_names",
        "required_status"
      ],
      "properties": {
        "command_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "command": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "cwd": { "type": "string", "minLength": 1 },
        "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
        "env_names": { "type": "array", "items": { "type": "string" } },
        "required_status": { "type": "string", "const": "verified" }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "path": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "proof_boundary": {
      "type": "object",
      "required": ["publication_status", "verification_status", "agent_authored_effects_accepted"],
      "properties": {
        "publication_status": { "type": "string", "const": "not_started" },
        "verification_status": { "type": "string", "const": "not_started" },
        "agent_authored_effects_accepted": { "type": "boolean", "const": false }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "decision": { "const": "ready_for_approval" } },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "preparation": {
            "type": "object",
            "properties": { "status": { "const": "ready" } }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
