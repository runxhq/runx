name: sbom-inventory-reuse
steps:
  - id: inventory
    skill: ../..
    runner: inventory-source
    inputs:
      source_text: '{"name":"fixture-project","lockfileVersion":3,"packages":{"":{"name":"fixture-project","dependencies":{"alias":"npm:@scope/real@1.2.3","local":"workspace:*"}},"node_modules/alias":{"name":"@scope/real","version":"1.2.3","license":"MIT","resolved":"https://registry.npmjs.org/@scope/real/-/real-1.2.3.tgz"},"node_modules/local":{"resolved":"packages/local","link":true}}}'
      source_label: fixture:package-lock.json
      lockfile_type: package-lock
  - id: generate
    skill: ../..
    runner: from-inventory
    inputs:
      inventory: $steps.inventory.inventory
  - id: same
    tool: data.compare
    inputs:
      actual: $steps.inventory.inventory
      expected: $steps.generate.inventory
