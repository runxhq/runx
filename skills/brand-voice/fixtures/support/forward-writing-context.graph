name: brand-voice-forward-writing-context
steps:
  - id: voice
    skill: ../..
    runner: voice
    inputs:
      brand: runx
      channel: public_update
      audience: advanced software builders
      source_material:
        - { kind: approved, label: product contract, content: Runx receipts bind operator actions to explicit authority evidence. }
        - { kind: rejected, label: rejected launch copy, content: Autonomous everything with no review. }
  - id: draft
    skill: ../../../ghostwrite
    runner: draft
    inputs:
      objective: Explain the strongest Runx architecture signal.
      audience: operators
      channel: brief
      evidence_pack:
        decision: ready
        research_brief:
          objective: Explain the strongest Runx architecture signal.
          scope: Supplied architecture evidence only.
          summary: Receipts bind actions to authority evidence.
          open_questions: []
        evidence_log:
          - claim: Receipts bind actions to authority evidence.
            source_digest: sha256:1111111111111111111111111111111111111111111111111111111111111111
            content_digest: sha256:1111111111111111111111111111111111111111111111111111111111111111
            confidence: verified
            relevance: Direct support for the requested claim.
        decision_support: []
        risks: []
        source_evidence:
          - evidence_digest: sha256:1111111111111111111111111111111111111111111111111111111111111111
            content_digest: sha256:1111111111111111111111111111111111111111111111111111111111111111
            source_ref: file:fixtures/architecture-evidence.txt
            source_kind: local_file
            provenance: { admitted_by: harness }
        index_digest: sha256:1111111111111111111111111111111111111111111111111111111111111111
        validation: { status: pass, findings: [] }
    context:
      brand_context: voice.brand_voice_packet.data
  - id: social-plan
    skill: ../../../twitter
    runner: plan
    inputs:
      objective: Prepare one exact public update about governed receipts.
      principal: account:@runx
    context:
      brand_context: voice.brand_voice_packet.data
