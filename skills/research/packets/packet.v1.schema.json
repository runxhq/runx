{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/packages/runx/research/packet/v1.json",
  "x-runx-packet-id": "runx/research.packet.v1",
  "type": "object",
  "required": ["decision", "research_brief", "evidence_log", "decision_support", "risks", "source_evidence", "index_digest", "validation"],
  "properties": {
    "decision": { "enum": ["ready", "needs_more_evidence", "not_worth_publishing"] },
    "research_brief": {
      "type": "object",
      "required": ["objective", "scope", "summary", "open_questions"],
      "properties": {
        "objective": { "type": "string" },
        "scope": { "type": "string" },
        "summary": { "type": "string" },
        "open_questions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "evidence_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "source_digest", "content_digest", "confidence", "relevance"],
        "properties": {
          "claim": { "type": "string" },
          "source_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "content_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "confidence": { "enum": ["verified", "inference"] },
          "relevance": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "decision_support": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["option", "rationale", "source_digests"],
        "properties": {
          "option": { "type": "string" },
          "rationale": { "type": "string" },
          "source_digests": { "type": "array", "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
        },
        "additionalProperties": false
      }
    },
    "risks": { "type": "array" },
    "source_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_digest", "content_digest", "source_uri", "source_kind", "provenance"],
        "properties": {
          "evidence_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "content_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "source_uri": { "type": "string" },
          "source_kind": { "enum": ["fetch", "local_file"] },
          "provenance": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": false
      }
    },
    "index_digest": { "type": "string" },
    "deliverable": { "type": "string" },
    "validation": {
      "type": "object",
      "required": ["status", "findings"],
      "properties": {
        "status": { "enum": ["pass", "fail"] },
        "findings": { "type": "array" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
