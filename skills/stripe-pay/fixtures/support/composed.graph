name: stripe-pay-composed
steps:
  - id: stripe-pay
    skill: ../..
    runner: stripe-spt
    inputs:
      payment_signal: { amount_minor: 125, currency: USD, counterparty: "merchant:demo" }
      parent_payment_authority: { term_id: "authority:test" }
      rail_profile_ref: "rail-profile:stripe-test"
      idempotency_seed: stripe-test-001
  - id: digest
    tool: data.digest
    inputs:
      value: $steps.stripe-pay
