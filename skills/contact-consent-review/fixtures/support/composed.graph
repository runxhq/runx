name: contact-consent-review-composed
steps:
  - id: contact-consent-review
    skill: ../..
    runner: judge
    inputs:
      data_source_ref: local://contact-consent-review/decay
      resource: contact_consent_events
      aggregate_id: contact:decay
      expected_version: 0
      idempotency_key: contact:decay:consent:v1
      engagement_evidence: { hard_bounces: 0, recency_days: 121 }
      hygiene_policy: { hard_bounce_action: suppress, decay_threshold_days: 90 }
      consent_evidence: { state: subscribed, active_unsubscribe_marker: false, evidence_status: read, evidence_version: 0 }
  - id: digest
    tool: data.digest
    inputs:
      value: $steps.contact-consent-review
