name: product-analytics-composed
steps:
  - id: product-analytics
    skill: ../..
    runner: analyze
    inputs:
      objective: Find activation gaps
      reports:
      - name: current
        complete: true
        source_digest: sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
        observed_at: '2026-10-09T00:00:00Z'
        window:
          start_at: '2026-09-01T00:00:00Z'
          end_at: '2026-09-08T00:00:00Z'
        definition:
          product: Example
          identity: account
          time_zone: UTC
          cohort: new accounts
          filters: exclude test accounts
          funnel_rule: same accounts, ordered within seven days
          retention_rule: active on day seven
        funnel:
          steps:
          - event: signup
            count: 100
          - event: activated
            count: 75
        retention:
          period: day 7
          eligible: 80
          returned: 40
  - id: digest
    tool: data.digest
    inputs:
      value: $steps.product-analytics
