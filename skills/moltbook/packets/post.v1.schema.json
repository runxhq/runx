{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/packages/runx/moltbook/post/v1.json",
  "x-runx-packet-id": "runx/moltbook.post.v1",
  "type": "object",
  "properties": {
    "post_payload": { "type": "object", "additionalProperties": true },
    "moderation_notes": { "type": "object", "additionalProperties": true },
    "publish_plan": { "type": "object", "additionalProperties": true },
    "post": { "type": "object", "additionalProperties": true },
    "handoff": { "type": "object", "additionalProperties": true },
    "source_evidence": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "topic": { "type": "string", "description": "Original admitted source topic; needed for post drafting." },
          "summary": { "type": "string", "description": "Original admitted source text; ids alone do not support post claims." },
          "observed_at": { "type": "string", "format": "date-time" }
        },
        "required": ["source_id", "observed_at"],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
