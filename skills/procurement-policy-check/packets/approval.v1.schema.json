{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/packages/runx/procurement-policy-check/approval/v1.json",
  "x-runx-packet-id": "runx/procurement-policy-check.approval.v1",
  "type": "object",
  "required": [
    "schema",
    "decision",
    "reason",
    "payee",
    "amount",
    "currency",
    "ceiling_amount",
    "human_lane",
    "refused_reason",
    "policy_ids",
    "validation",
    "spend_executed",
    "request_digest",
    "policy_digest"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "runx/procurement-policy-check.approval.v1"
    },
    "decision": {
      "type": "string",
      "enum": [
        "approved",
        "refused",
        "needs_human"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "payee": {
      "type": "string",
      "maxLength": 500
    },
    "amount": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "maxLength": 10
    },
    "ceiling_amount": {
      "type": "number",
      "minimum": 0
    },
    "human_lane": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "refused_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "policy_ids": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "status",
        "findings"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        },
        "findings": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          }
        }
      }
    },
    "spend_executed": {
      "const": false
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
