name: privacy-conflicted-append
steps:
  - id: first-verdict
    skill: ../..
    runner: decide
    inputs:
      request_packet: &a1
        type: erasure
        subject_id: subject:alice
        scope:
          request_id: dsr-001
          data_classes:
            - profile
            - activity
          requested_scopes:
            - profile
            - activity
      requestor_proof: &a2
        identity_provider: idp:acme
        verified_at: 2026-08-01T10:00:00Z
        assertion:
          subject_id: subject:alice
          assertion_id: idp:acme:session:9911
          assertion_digest: sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
      policy: &a3
        jurisdiction: GDPR
        trusted_identity_providers:
          - idp:acme
        lawful_bases:
          erasure: art17_right_to_erasure
        scope_bounds:
          data_classes:
            - profile
            - activity
            - billing
          erasure_allowed:
            - profile
            - activity
          export_allowed:
            - profile
      data_source_uri: local://privacy-request-review/conflict
      resource: subject_requests
      aggregate_id: subject:conflict
      expected_version: 0
      idempotency_key: privacy-conflict-v1
  - id: stale-verdict
    skill: ../..
    runner: decide
    inputs:
      request_packet: *a1
      requestor_proof: *a2
      policy: *a3
      data_source_uri: local://privacy-request-review/conflict
      resource: subject_requests
      aggregate_id: subject:conflict
      expected_version: 0
      idempotency_key: privacy-conflict-v2
