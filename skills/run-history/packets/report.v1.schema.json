{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/packages/runx/run-history/report/v1.json",
  "x-runx-packet-id": "runx/run-history.report.v1",
  "type": "object",
  "required": [
    "history_report"
  ],
  "properties": {
    "history_report": {
      "additionalProperties": false,
      "properties": {
        "catalog": {
          "additionalProperties": false,
          "properties": {
            "coverage_rate": {
              "maximum": 1,
              "minimum": 0,
              "type": [
                "number",
                "null"
              ]
            },
            "entry_count": {
              "minimum": 0,
              "type": "integer"
            },
            "tested_entry_count": {
              "minimum": 0,
              "type": "integer"
            },
            "untested_entry_count": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "entry_count",
            "tested_entry_count",
            "untested_entry_count",
            "coverage_rate"
          ],
          "type": "object"
        },
        "decision": {
          "enum": [
            "ready",
            "needs_more_evidence"
          ],
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "objective": {
          "minLength": 1,
          "type": "string"
        },
        "query": {
          "additionalProperties": false,
          "properties": {
            "limit": {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            },
            "period": {
              "type": [
                "string",
                "null"
              ]
            },
            "scope": {
              "type": "string"
            },
            "since": {
              "type": [
                "string",
                "null"
              ]
            },
            "skill_filter": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "scope",
            "period",
            "since",
            "skill_filter",
            "limit"
          ],
          "type": "object"
        },
        "recommendations": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "action": {
                "type": "string"
              },
              "lane": {
                "type": "string"
              }
            },
            "required": [
              "lane",
              "action"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "runs": {
          "additionalProperties": false,
          "properties": {
            "completed_rate": {
              "maximum": 1,
              "minimum": 0,
              "type": [
                "number",
                "null"
              ]
            },
            "outcomes": {
              "additionalProperties": {
                "minimum": 0,
                "type": "integer"
              },
              "type": "object"
            },
            "pending_count": {
              "minimum": 0,
              "type": "integer"
            },
            "refusal_rate": {
              "maximum": 1,
              "minimum": 0,
              "type": [
                "number",
                "null"
              ]
            },
            "terminal_count": {
              "minimum": 0,
              "type": "integer"
            },
            "top_subjects": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "count": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "subject": {
                    "type": "string"
                  }
                },
                "required": [
                  "subject",
                  "count"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "terminal_count",
            "pending_count",
            "outcomes",
            "completed_rate",
            "refusal_rate",
            "top_subjects"
          ],
          "type": "object"
        },
        "schema": {
          "const": "runx/run-history.report.v1"
        },
        "sources": {
          "additionalProperties": false,
          "properties": {
            "catalog": {
              "enum": [
                "supplied_replay",
                "runx.skill.inspect"
              ],
              "type": "string"
            },
            "history": {
              "enum": [
                "supplied_replay",
                "run.list"
              ],
              "type": "string"
            }
          },
          "required": [
            "history",
            "catalog"
          ],
          "type": "object"
        }
      },
      "required": [
        "schema",
        "decision",
        "objective",
        "query",
        "sources",
        "runs",
        "catalog",
        "recommendations",
        "limitations"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false
}
