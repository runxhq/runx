name: github-composed
steps:
  - id: github
    skill: ../..
    runner: plan
    inputs:
      repo: runxhq/runx
      direction: push
      resources:
        kind: batch
        mutations:
          - {ref: issues/241, op: update, payload: {labels: [triage]}}
          - {ref: issues/241/comments, op: comment, payload: {body: Triaged.}}
      scope: write
  - id: digest
    tool: data.digest
    inputs:
      value: $steps.github
