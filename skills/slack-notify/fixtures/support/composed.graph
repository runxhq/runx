name: slack-notify-composed
steps:
  - id: slack-notify
    skill: ../..
    runner: plan
    inputs:
      channel: "#ops"
      content:
        message: Deploy completed and health checks are green.
      principal: team:operations
      provider_context:
        connector: unavailable
  - id: digest
    tool: data.digest
    inputs:
      value: $steps.slack-notify
