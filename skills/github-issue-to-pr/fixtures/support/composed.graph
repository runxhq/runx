name: github-issue-to-pr-composed
steps:
  - id: github-issue-to-pr
    skill: ../..
    runner: resume
    inputs:
      issue_evidence:
        schema: runx/github-issue-to-pr.issue_evidence.v1
        repository: runxhq/runx
        number: "442"
        title: Make issue-to-PR operator-first
        state: open
        body: Reuse prior evidence instead of reading the provider again.
        url: https://github.com/runxhq/runx/issues/442
        labels: [operator-experience]
        assignees: []
        source:
          provider: github
          transport: local_http
          principal_uri: runx:principal:github:7
          readback_uri: runx:github-readback:sha256:fixture
      host_result:
        schema: runx/github-issue-to-pr.host_result.v1
        status: completed
        repository: runxhq/runx
        issue_number: "442"
        repo_root: .
        branch: fix/442-operator-first
        commit: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
        files: [oss/skills/github-issue-to-pr/run.yaml]
        tests:
          - command: cargo test -p runx-cli --test integration issue_to_pr_journey
            status: passed
            evidence: receipt:test:github-issue-to-pr-composed
        finalization:
          receipt_path: fixtures/scafld-pass.json
          contract_digest: sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
        publication:
          decision: hold
          title: ""
          body: ""
          head: ""
          base: ""
          draft: false
          idempotency_key: ""
        errors: []
  - id: digest
    tool: data.digest
    inputs:
      value: $steps.github-issue-to-pr
