name: dispute-response-prepared-evidence-composition
steps:
  - id: capture
    skill: ../..
    runner: capture
    inputs:
      account_id: acct_northstar
      dispute_id: du_case42
      evidence: []
  - id: prepare
    skill: ../..
    runner: from-evidence
    inputs:
      account_id: acct_northstar
      dispute_id: du_case42
      case_evidence: $steps.capture.case_context.case_evidence
      charge_evidence: $steps.capture.case_context.charge_evidence
      evidence:
        - id: delivery-42
          kind: delivery
          content: Report 42 was downloaded by the buyer at 2026-11-03T01:00:00Z.
          source: merchant://orders/42/access-log
  - id: file
    skill: ../..
    runner: file
    inputs:
      prepared_response: $steps.prepare.prepared_response
