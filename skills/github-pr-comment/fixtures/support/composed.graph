name: github-pr-comment-composed
steps:
  - id: github-pr-comment
    skill: ../..
    runner: post
    inputs:
      repository: runxhq/runx
      pr_number: "42"
      body: The reviewed path is sound; please add the missing harness case.
      idempotency_key: runxhq-runx-pr-42-connect-note-v1
  - id: digest
    tool: data.digest
    inputs:
      value: $steps.github-pr-comment
