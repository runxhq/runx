name: operator-inbox-action-lifecycle
owner: runx
steps:
  - id: plan-observation
    skill: ../../graph/plan
    inputs:
      operation: action_observation
      expected_version: 0
      observed_at: "2026-07-14T00:00:00.000Z"
      triage:
        kind: direct_mention
        reason: The connected operator was directly mentioned.
      message:
        provider: fixture
        external_tenant_ref: workspace-1
        connected_subject_ref: operator-1
        message_locator: fixture://workspace-1/general/100
        thread_locator: fixture://workspace-1/general/100
        author:
          external_id: user-1
          display_name: Teammate
        conversation:
          external_id: general
          display_name: General
          type: channel
        occurred_at: "2026-07-13T23:59:00.000Z"
        preview: Please review the analytics result.
        context: []
  - id: append-observation
    skill: ../../../data-store
    runner: append_event
    inputs:
      data_source_ref: local://runx/operator-inbox/action-lifecycle
      resource: operator_inbox_actions
      aggregate_id: action-04a315f3a0af034c1c2022c0a15eb6b6b2819a63839f02f77187fd30163d1cd1
      expected_version: 0
      observed_at: "2026-07-13T23:59:00.000Z"
      idempotency_key: $steps.plan-observation.transition.idempotency_key
      event: $steps.plan-observation.transition.event
  - id: plan-disposition
    skill: ../../graph/plan
    inputs:
      operation: disposition
      expected_version: 1
      observed_at: "2026-07-14T00:05:00.000Z"
      disposition:
        status: resolved
        actor: operator-1
        reason: The requested review was completed.
      current_action: $steps.plan-observation.transition.event.payload.action
  - id: append-disposition
    skill: ../../../data-store
    runner: append_event
    inputs:
      data_source_ref: local://runx/operator-inbox/action-lifecycle
      resource: operator_inbox_actions
      aggregate_id: action-04a315f3a0af034c1c2022c0a15eb6b6b2819a63839f02f77187fd30163d1cd1
      expected_version: 1
      observed_at: "2026-07-14T00:05:00.000Z"
      idempotency_key: $steps.plan-disposition.transition.idempotency_key
      event: $steps.plan-disposition.transition.event
  - id: readback
    skill: ../../../data-store
    runner: read_projection
    inputs:
      data_source_ref: local://runx/operator-inbox/action-lifecycle
      resource: operator_inbox_actions
      aggregate_id: action-04a315f3a0af034c1c2022c0a15eb6b6b2819a63839f02f77187fd30163d1cd1
