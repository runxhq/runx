name: sourcey-lifecycle
owner: runx
steps:
  - id: seed-workspace
    tool: { command: node, args: [./seed_workspace.mjs] }
    outputs:
      fixture_workspace: object
    scopes:
      - fs.write
    artifacts:
      named_emits:
        fixture_workspace: fixture_workspace
  - id: run-sourcey
    skill: ../..
    runner: sourcey
    inputs:
      project: .runx/sourcey-journey/project
      repo_root: .
      homepage_url: https://runx.example.test
      brand_name: Runx Sourcey Journey
      docs_inputs:
        mode: config
        config: sourcey.config.ts
      output_dir: .sourcey/site
      sourcey_bin: ../bin/sourcey.mjs
