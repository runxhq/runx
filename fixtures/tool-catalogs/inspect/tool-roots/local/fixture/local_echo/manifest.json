{
  "schema": "runx.tool.manifest.v1",
  "name": "fixture.local_echo",
  "version": "0.0.1",
  "description": "Local inspect fixture tool.",
  "source": {
    "command": "node",
    "args": [
      "./run.mjs"
    ]
  },
  "inputs": {
    "message": {
      "type": "string",
      "required": true,
      "description": "Message to echo."
    }
  },
  "scopes": [
    "fixture.local_echo"
  ]
}
