{
  "schema": "runx.copyable_command.vectors.v1",
  "shell": "posix",
  "cases": [
    { "name": "install", "argv": ["runx", "add", "acme/brief@1.2.0"], "copy_text": "runx add acme/brief@1.2.0" },
    { "name": "run", "argv": ["runx", "skill", "acme/brief@v1.2.0+build.3"], "copy_text": "runx skill acme/brief@v1.2.0+build.3" },
    { "name": "content-label", "argv": ["runx", "add", "runx/sourcey@sha-abcdef123456"], "copy_text": "runx add runx/sourcey@sha-abcdef123456" },
    { "name": "flag-and-url", "argv": ["runx", "add", "acme/brief", "--registry", "https://registry.example/v1"], "copy_text": "runx add acme/brief --registry https://registry.example/v1" },
    { "name": "path-with-space", "argv": ["runx", "add", "acme/brief", "--registry", "/Users/a b/registry"], "copy_text": "runx add acme/brief --registry '/Users/a b/registry'" },
    { "name": "single-quote", "argv": ["runx", "skill", "it's"], "copy_text": "runx skill 'it'\\''s'" },
    { "name": "semicolon", "argv": ["runx", "skill", "a;rm -rf ~"], "copy_text": "runx skill 'a;rm -rf ~'" },
    { "name": "substitution", "argv": ["runx", "skill", "$(id)"], "copy_text": "runx skill '$(id)'" },
    { "name": "backtick", "argv": ["runx", "skill", "`id`"], "copy_text": "runx skill '`id`'" },
    { "name": "glob", "argv": ["runx", "skill", "*"], "copy_text": "runx skill '*'" },
    { "name": "tilde", "argv": ["runx", "skill", "~/x"], "copy_text": "runx skill '~/x'" },
    { "name": "assignment-sign", "argv": ["runx", "skill", "a=b"], "copy_text": "runx skill 'a=b'" },
    { "name": "empty-argument", "argv": ["runx", "skill", ""], "copy_text": "runx skill ''" },
    { "name": "unicode", "argv": ["runx", "skill", "café"], "copy_text": "runx skill 'café'" },
    { "name": "no-arguments", "argv": [] },
    { "name": "newline", "argv": ["runx", "skill", "a\nb"] },
    { "name": "carriage-return", "argv": ["runx", "skill", "a\rb"] },
    { "name": "nul", "argv": ["runx", "skill", "a\u0000b"] },
    { "name": "escape", "argv": ["runx", "skill", "a\u001b[31m"] }
