{
  "$id": "https://schemas.runx.ai/runx/registry-binding/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "harness": {
      "additionalProperties": true,
      "description": "Where a binding's harness verification is. Open.",
      "properties": {
        "assertion_count": {
          "type": "number"
        },
        "case_count": {
          "type": "number"
        },
        "case_names": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "state": {
          "enum": [
            "pending",
            "failed",
            "harness_verified"
          ],
          "title": "RegistryHarnessState",
          "type": "string"
        }
      },
      "required": [
        "state",
        "case_count"
      ],
      "title": "RegistryBindingHarness",
      "type": "object"
    },
    "registry": {
      "additionalProperties": true,
      "properties": {
        "materialized_package_is_registry_artifact": {
          "const": true
        },
        "profile_path": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "trust_tier": {
          "description": "How far the registry vouches for a publisher: runx's own packages, a publisher it verified, or anyone's.",
          "enum": [
            "first_party",
            "verified",
            "community"
          ],
          "title": "TrustTier",
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "publisher",
        "trust_tier",
        "version",
        "profile_path",
        "materialized_package_is_registry_artifact"
      ],
      "type": "object"
    },
    "schema": {
      "enum": [
        "runx.registry_binding.v1"
      ],
      "title": "RegistryBindingSchema",
      "type": "string"
    },
    "skill": {
      "additionalProperties": true,
      "description": "The skill identity for a registry binding. Open (`additionalProperties: true`).",
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "title": "RegistryBindingSkill",
      "type": "object"
    },
    "state": {
      "enum": [
        "registry_binding_drafted",
        "registry_bound",
        "harness_verified",
        "published"
      ],
      "title": "RegistryBindingState",
      "type": "string"
    },
    "upstream": {
      "additionalProperties": true,
      "properties": {
        "blob_sha": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "html_url": {
          "type": "string"
        },
        "merged_at": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "pr_url": {
          "type": "string"
        },
        "raw_url": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "source_of_truth": {
          "const": true
        }
      },
      "required": [
        "host",
        "owner",
        "repo",
        "path",
        "commit",
        "blob_sha",
        "source_of_truth"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema",
    "state",
    "skill",
    "upstream",
    "registry",
    "harness"
  ],
  "title": "RegistryBinding",
  "type": "object",
  "x-runx-schema": "runx.registry_binding.v1"
}
