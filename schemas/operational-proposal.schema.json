{
  "$id": "https://schemas.runx.ai/runx/operational-proposal/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed_next_actions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "artifact_refs": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/reference/v1.json"
      },
      "type": "array"
    },
    "authority": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/OperationalProposalAuthority"
    },
    "caveats": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "decision_summary": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/reference/v1.json"
      },
      "type": "array"
    },
    "extensions": {
      "additionalProperties": {},
      "type": "object"
    },
    "final_outcome": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/OperationalProposalOutcome"
    },
    "human_gates": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/OperationalProposalHumanGate"
      },
      "type": "array"
    },
    "hydrated_context_ref": {
      "$ref": "https://schemas.runx.ai/runx/reference/v1.json"
    },
    "idempotency": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/OperationalProposalIdempotency"
    },
    "missing_context": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "owner_route_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "type": "string"
    },
    "proposal_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "type": "string"
    },
    "proposal_kind": {
      "minLength": 1,
      "type": "string"
    },
    "public_summary": {
      "minLength": 1,
      "type": "string"
    },
    "publication_refs": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/ReferenceLink"
      },
      "type": "array"
    },
    "rationale": {
      "minLength": 1,
      "type": "string"
    },
    "receipt_refs": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/reference/v1.json"
      },
      "type": "array"
    },
    "recommended_actions": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/OperationalProposalRecommendedAction"
      },
      "type": "array"
    },
    "redaction_status": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/OperationalProposalRedactionStatus"
    },
    "result_refs": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/ReferenceLink"
      },
      "type": "array"
    },
    "risks": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "schema": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/OperationalProposalSchema"
    },
    "source_event_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "type": "string"
    },
    "source_ref": {
      "$ref": "https://schemas.runx.ai/runx/reference/v1.json"
    },
    "source_thread_ref": {
      "$ref": "https://schemas.runx.ai/runx/reference/v1.json"
    },
    "story_refs": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/reference/v1.json"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "proposal_id",
    "proposal_kind",
    "source_event_id",
    "idempotency",
    "source_ref",
    "hydrated_context_ref",
    "redaction_status",
    "decision_summary",
    "rationale",
    "owner_route_id",
    "confidence",
    "authority",
    "public_summary"
  ],
  "title": "OperationalProposal",
  "type": "object",
  "x-runx-schema": "runx.operational_proposal.v1"
}
