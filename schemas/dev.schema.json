{
  "$id": "https://schemas.runx.ai/runx/dev/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "doctor": {
      "$id": "https://schemas.runx.ai/runx/doctor/v1.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "diagnostics": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "evidence": {
                "additionalProperties": {},
                "type": "object"
              },
              "id": {
                "type": "string"
              },
              "instance_id": {
                "type": "string"
              },
              "location": {
                "additionalProperties": false,
                "properties": {
                  "json_pointer": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "path"
                ],
                "type": "object"
              },
              "message": {
                "type": "string"
              },
              "repairs": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "command": {
                      "type": "string"
                    },
                    "confidence": {
                      "enum": [
                        "low",
                        "medium",
                        "high"
                      ],
                      "type": "string"
                    },
                    "contents": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "json_pointer": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "create_file",
                        "replace_file",
                        "edit_yaml",
                        "edit_json",
                        "add_fixture",
                        "run_command",
                        "manual"
                      ],
                      "type": "string"
                    },
                    "patch": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "requires_human_review": {
                      "type": "boolean"
                    },
                    "risk": {
                      "enum": [
                        "low",
                        "medium",
                        "high",
                        "sensitive"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "kind",
                    "confidence",
                    "risk",
                    "requires_human_review"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "severity": {
                "enum": [
                  "error",
                  "warning",
                  "info"
                ],
                "type": "string"
              },
              "target": {
                "additionalProperties": {},
                "type": "object"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "instance_id",
              "severity",
              "title",
              "message",
              "target",
              "location",
              "repairs"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "schema": {
          "enum": [
            "runx.doctor.v1"
          ],
          "type": "string"
        },
        "status": {
          "enum": [
            "success",
            "failure"
          ],
          "type": "string"
        },
        "summary": {
          "additionalProperties": false,
          "properties": {
            "errors": {
              "type": "integer"
            },
            "infos": {
              "type": "integer"
            },
            "warnings": {
              "type": "integer"
            }
          },
          "required": [
            "errors",
            "warnings",
            "infos"
          ],
          "type": "object"
        }
      },
      "required": [
        "schema",
        "status",
        "summary",
        "diagnostics"
      ],
      "type": "object",
      "x-runx-schema": "runx.doctor.v1"
    },
    "fixtures": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "assertions": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "actual": {},
                "expected": {},
                "kind": {
                  "enum": [
                    "subset_miss",
                    "exact_mismatch",
                    "packet_invalid",
                    "status_mismatch",
                    "type_mismatch"
                  ],
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "kind",
                "message"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "duration_ms": {
            "type": "integer"
          },
          "lane": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "output": {},
          "replay_path": {
            "type": "string"
          },
          "skip_reason": {
            "type": "string"
          },
          "status": {
            "enum": [
              "success",
              "failure",
              "skipped"
            ],
            "type": "string"
          },
          "target": {
            "additionalProperties": {},
            "type": "object"
          }
        },
        "required": [
          "name",
          "lane",
          "target",
          "status",
          "duration_ms",
          "assertions"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "receipt_id": {
      "type": "string"
    },
    "schema": {
      "enum": [
        "runx.dev.v1"
      ],
      "type": "string"
    },
    "status": {
      "enum": [
        "success",
        "failure",
        "skipped",
        "needs_approval"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema",
    "status",
    "doctor",
    "fixtures"
  ],
  "type": "object",
  "x-runx-schema": "runx.dev.v1"
}
