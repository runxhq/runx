{
  "$id": "https://schemas.runx.ai/runx/receipt/query/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What `receipt.query` returns: the receipts a filter matched in the native receipt store, with detail and tree verification when asked for.",
  "properties": {
    "filter": {
      "additionalProperties": {},
      "type": "object"
    },
    "receipt_details": {
      "items": {
        "additionalProperties": {},
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 0,
      "type": "array"
    },
    "receipt_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "receipts": {
      "items": {
        "additionalProperties": {},
        "type": "object"
      },
      "type": "array"
    },
    "schema": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/ReceiptQuerySchema"
    },
    "source": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/ReceiptQuerySource"
    },
    "store_label": {
      "minLength": 1,
      "type": "string"
    },
    "verification": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/ReceiptQueryVerification"
    }
  },
  "required": [
    "schema",
    "source",
    "store_label",
    "filter",
    "receipt_ids",
    "receipts",
    "receipt_details",
    "verification"
  ],
  "title": "ReceiptQuery",
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.receipt.query.v1"
}
