{
  "$id": "https://schemas.runx.ai/runx/run/list/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What `run.list` returns: the workspace's top-level runs, most recently advanced first, and those whose record this runx can't read.",
  "properties": {
    "runs": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/RunListEntry"
      },
      "maxItems": 1000,
      "minItems": 0,
      "type": "array"
    },
    "schema": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/RunListSchema"
    },
    "unreadable": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/UnreadableRun"
      },
      "maxItems": 1000,
      "minItems": 0,
      "type": "array"
    }
  },
  "required": [
    "schema",
    "runs",
    "unreadable"
  ],
  "title": "RunList",
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.run.list.v1"
}
