{
  "$id": "https://schemas.runx.ai/runx/git/log/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What `git.log` reports: the commits reachable from `revision`, newest first, and whether more were left out.",
  "properties": {
    "commits": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/GitCommit"
      },
      "maxItems": 200,
      "minItems": 0,
      "type": "array"
    },
    "repo_root": {
      "minLength": 1,
      "type": "string"
    },
    "revision": {
      "minLength": 1,
      "type": "string"
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "repo_root",
    "revision",
    "commits",
    "truncated"
  ],
  "title": "GitLog",
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.git.log.v1"
}
