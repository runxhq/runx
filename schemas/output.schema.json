{
  "$id": "https://runx.ai/spec/output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "patternProperties": {
    "^(.*)$": {
      "anyOf": [
        {
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "array",
            "object",
            "null"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string"
            },
            "enum": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "required": {
              "type": "boolean"
            },
            "schema": {
              "additionalProperties": {},
              "type": "object"
            },
            "type": {
              "enum": [
                "string",
                "number",
                "integer",
                "boolean",
                "array",
                "object",
                "null"
              ],
              "type": "string"
            },
            "wrap_as": {
              "minLength": 1,
              "type": "string"
            }
          },
          "type": "object"
        }
      ]
    }
  },
  "type": "object"
}
