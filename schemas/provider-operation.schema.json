{
  "$id": "https://schemas.runx.ai/runx/provider/operation/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The provider-neutral packet emitted after a provider operation has been projected and, for mutations, independently read back. Provider adapters own the shape of `result`; Runx owns this envelope and its identity fields.",
  "properties": {
    "access": {
      "type": "string"
    },
    "account_id": {
      "type": "string"
    },
    "cost": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/CallCost",
      "description": "What a priced call cost; absent when the operation declares no cost."
    },
    "finality": {
      "type": "string"
    },
    "grant_uri": {
      "type": "string"
    },
    "host": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string"
    },
    "implementation_digest": {
      "description": "The local implementation that ran; absent for hosted calls.",
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "operation_digest": {
      "description": "What the operation meant when the call was admitted.",
      "type": "string"
    },
    "operation_id": {
      "type": "string"
    },
    "plan_digest": {
      "type": "string"
    },
    "principal_uri": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "readback_uri": {
      "type": "string"
    },
    "result": {},
    "result_digest": {
      "type": "string"
    },
    "schema": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "transport": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "status",
    "provider",
    "operation",
    "target",
    "result",
    "transport",
    "readback_uri"
  ],
  "title": "ProviderOperationPacket",
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.provider.operation.v1"
}
