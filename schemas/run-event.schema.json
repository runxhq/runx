{
  "$id": "https://schemas.runx.ai/runx/run-event/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One event of a run's record. It carries references and digests, never outputs or secrets.",
  "properties": {
    "committed_at": {
      "description": "When the event committed, for display only: it orders nothing.",
      "minLength": 1,
      "type": "string"
    },
    "event": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "started",
              "type": "string"
            },
            "runner": {
              "minLength": 1,
              "type": "string"
            },
            "skill": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "skill",
            "runner"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "child_started",
              "type": "string"
            },
            "parent": {
              "minLength": 1,
              "type": "string"
            },
            "skill": {
              "minLength": 1,
              "type": "string"
            },
            "step_id": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "parent",
            "step_id",
            "skill"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "attempt": {
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "step",
              "type": "string"
            },
            "receipt_id": {
              "minLength": 1,
              "type": "string"
            },
            "step_id": {
              "minLength": 1,
              "type": "string"
            },
            "succeeded": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "step_id",
            "attempt",
            "succeeded",
            "receipt_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "skipped",
              "type": "string"
            },
            "step_ids": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "step_ids"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "attempt": {
              "minimum": 0,
              "type": "integer"
            },
            "hold": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "description": "On a request it raised.",
                  "properties": {
                    "address": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "kind": {
                      "const": "request",
                      "type": "string"
                    },
                    "request_digest": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "address",
                    "request_digest"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "description": "On a bounded retry; the step has not started.",
                  "properties": {
                    "address": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "kind": {
                      "const": "retry",
                      "type": "string"
                    },
                    "request_digest": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "address",
                    "request_digest"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "description": "On its retry after it was claimed: it reaches the world, and its effect may have happened.",
                  "properties": {
                    "address": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "kind": {
                      "const": "claimed",
                      "type": "string"
                    },
                    "request_digest": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "address",
                    "request_digest"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "description": "On what the child run it started waits on.",
                  "properties": {
                    "kind": {
                      "const": "child",
                      "type": "string"
                    },
                    "run_id": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "run_id"
                  ],
                  "type": "object"
                }
              ],
              "description": "Where a suspended step waits.",
              "title": "RunHold"
            },
            "kind": {
              "const": "suspended",
              "type": "string"
            },
            "step_id": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "step_id",
            "attempt",
            "hold"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "attempt": {
              "minimum": 0,
              "type": "integer"
            },
            "call_id": {
              "description": "The id its host pinned on the call.",
              "minLength": 1,
              "type": "string"
            },
            "index": {
              "minimum": 0,
              "type": "integer"
            },
            "input_digest": {
              "minLength": 1,
              "type": "string"
            },
            "kind": {
              "const": "call",
              "type": "string"
            },
            "outcome": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "outputs": {
                      "description": "The call's output as project artifacts of its run: one per packet output, and one for the rest.",
                      "items": {
                        "additionalProperties": false,
                        "description": "A project artifact holding part of a call's output.",
                        "properties": {
                          "artifact": {
                            "$id": "https://schemas.runx.ai/runx/project-artifact/v1.json",
                            "$schema": "https://json-schema.org/draft/2020-12/schema",
                            "additionalProperties": false,
                            "properties": {
                              "bytes": {
                                "minimum": 0,
                                "type": "integer"
                              },
                              "digest": {
                                "type": "string"
                              },
                              "media_type": {
                                "type": "string"
                              },
                              "path": {
                                "type": "string"
                              },
                              "schema": {
                                "enum": [
                                  "runx.project_artifact.v1"
                                ],
                                "title": "ProjectArtifactSchema",
                                "type": "string"
                              },
                              "uri": {
                                "description": "`runx:project-artifact:` and the artifact's digest.",
                                "type": "string"
                              }
                            },
                            "required": [
                              "schema",
                              "uri",
                              "digest",
                              "bytes",
                              "media_type",
                              "path"
                            ],
                            "title": "ProjectArtifact",
                            "type": "object",
                            "x-runx-schema": "runx.project_artifact.v1"
                          },
                          "output": {
                            "description": "The packet output it holds; absent on the artifact of the call's other outputs.",
                            "minLength": 1,
                            "type": "string"
                          }
                        },
                        "required": [
                          "artifact"
                        ],
                        "title": "RunCallOutput",
                        "type": "object"
                      },
                      "minItems": 1,
                      "type": "array"
                    },
                    "reason": {
                      "description": "Why a call that ran did not succeed.",
                      "minLength": 1,
                      "type": "string"
                    },
                    "receipt_id": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "status": {
                      "const": "completed",
                      "type": "string"
                    },
                    "succeeded": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "status",
                    "succeeded",
                    "receipt_id"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "description": "Admission refused the call; nothing ran.",
                  "properties": {
                    "reason": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "status": {
                      "const": "refused",
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "reason"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "description": "The call could not run.",
                  "properties": {
                    "reason": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "status": {
                      "const": "failed",
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "reason"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "address": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "request_digest": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "status": {
                      "const": "pending",
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "address",
                    "request_digest"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "description": "Claimed and not settled: its effect may have happened.",
                  "properties": {
                    "address": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "request_digest": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "status": {
                      "const": "claimed",
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "address",
                    "request_digest"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "run_id": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "status": {
                      "const": "child",
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "run_id"
                  ],
                  "type": "object"
                }
              ],
              "description": "How a call stood when this event recorded it.",
              "title": "RunCallOutcome"
            },
            "standing": {
              "additionalProperties": false,
              "description": "The standing approval that admitted it on the approval floor, when one did.",
              "properties": {
                "commands": {
                  "additionalProperties": false,
                  "description": "A command or process whose argv begins with these tokens.",
                  "properties": {
                    "argv_prefix": {
                      "description": "The exact leading argv tokens. Argv has no shell, so a prefix admits nothing beyond the tokens it names.",
                      "items": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "argv_prefix"
                  ],
                  "title": "StandingCommands",
                  "type": "object"
                },
                "edits": {
                  "additionalProperties": false,
                  "description": "File changes under these paths.",
                  "properties": {
                    "paths": {
                      "description": "Workspace-relative path prefixes, by whole components; `\"\"` is the whole workspace.",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "paths"
                  ],
                  "title": "StandingEdits",
                  "type": "object"
                },
                "local": {
                  "const": true,
                  "description": "Every local effect.",
                  "type": "boolean"
                }
              },
              "title": "StandingApproval",
              "type": "object"
            },
            "step_id": {
              "minLength": 1,
              "type": "string"
            },
            "target": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "tool",
                      "type": "string"
                    },
                    "tool": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "tool"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "operation",
                      "type": "string"
                    },
                    "operation": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "requirement": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "requirement",
                    "operation"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "description": "A child skill: one the allowance names, run by its default runner, or one runner of a skill a load bound, run as the load bound it.",
                  "properties": {
                    "bound": {
                      "additionalProperties": false,
                      "description": "The exact package and execution closure a load bound for one runner.",
                      "properties": {
                        "closure_digest": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "package_digest": {
                          "minLength": 1,
                          "type": "string"
                        }
                      },
                      "required": [
                        "package_digest",
                        "closure_digest"
                      ],
                      "title": "BoundClosure",
                      "type": "object"
                    },
                    "kind": {
                      "const": "skill",
                      "type": "string"
                    },
                    "runner": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "skill": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "skill"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "description": "The call's input is `{reason}`; the human approves or declines it.",
                  "properties": {
                    "kind": {
                      "const": "ask",
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "description": "The call's input is `{skill, runner?}` or `{connector}`: a package a catalog rule admits, whose runners or operations the turn offers from then on.",
                  "properties": {
                    "kind": {
                      "const": "load",
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "type": "object"
                }
              ],
              "description": "What a turn call names: one entry of the turn's allowance.",
              "title": "TurnTarget"
            },
            "turn": {
              "description": "The address of the turn the call was made in.",
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "step_id",
            "attempt",
            "turn",
            "index",
            "target",
            "input_digest",
            "outcome"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "sealed",
              "type": "string"
            },
            "outcome": {
              "description": "How a run, or a receipt's subject, ended.",
              "enum": [
                "completed",
                "deferred",
                "superseded",
                "declined",
                "blocked",
                "failed",
                "killed",
                "timed_out"
              ],
              "title": "RunOutcome",
              "type": "string"
            },
            "receipt_id": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "outcome",
            "receipt_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The person replaced the run's standing approvals for every later step.",
          "properties": {
            "approvals": {
              "items": {
                "additionalProperties": false,
                "description": "A person's bounded confirmation of the local effects a run worked by an agent would otherwise hold for them: exactly one of `edits`, `commands` and `local`. It never covers an operation's own declared approval.",
                "properties": {
                  "commands": {
                    "additionalProperties": false,
                    "description": "A command or process whose argv begins with these tokens.",
                    "properties": {
                      "argv_prefix": {
                        "description": "The exact leading argv tokens. Argv has no shell, so a prefix admits nothing beyond the tokens it names.",
                        "items": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "type": "array"
                      }
                    },
                    "required": [
                      "argv_prefix"
                    ],
                    "title": "StandingCommands",
                    "type": "object"
                  },
                  "edits": {
                    "additionalProperties": false,
                    "description": "File changes under these paths.",
                    "properties": {
                      "paths": {
                        "description": "Workspace-relative path prefixes, by whole components; `\"\"` is the whole workspace.",
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    },
                    "required": [
                      "paths"
                    ],
                    "title": "StandingEdits",
                    "type": "object"
                  },
                  "local": {
                    "const": true,
                    "description": "Every local effect.",
                    "type": "boolean"
                  }
                },
                "title": "StandingApproval",
                "type": "object"
              },
              "type": "array"
            },
            "kind": {
              "const": "standing",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "approvals"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A resume admitted a person's decision on the request at `address`, before it took the run further; the run's next driver to reach the request uses it.",
          "properties": {
            "actor": {
              "enum": [
                "human",
                "agent"
              ],
              "title": "ResolutionResponseActor",
              "type": "string"
            },
            "address": {
              "minLength": 1,
              "type": "string"
            },
            "answer_digest": {
              "description": "`sha256:` over the answer's value.",
              "minLength": 1,
              "type": "string"
            },
            "kind": {
              "const": "answered",
              "type": "string"
            },
            "request_digest": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "address",
            "request_digest",
            "answer_digest",
            "actor"
          ],
          "type": "object"
        }
      ],
      "title": "RunEventFact"
    },
    "stream": {
      "description": "The stream: the run id, or `<run>/<path>` for a child run.",
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "stream",
    "version",
    "committed_at",
    "event"
  ],
  "title": "RunEventRecord",
  "type": "object",
  "x-runx-schema": "runx.run_event.v1"
}
