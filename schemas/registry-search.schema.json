{
  "$id": "https://schemas.runx.ai/runx/registry/search/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What `registry.search` found for a query, in the project and the registry.",
  "properties": {
    "hits": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/CatalogHit"
      },
      "type": "array"
    },
    "query": {
      "type": "string"
    }
  },
  "required": [
    "query",
    "hits"
  ],
  "title": "RegistrySearchPacket",
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.registry.search.v1"
}
