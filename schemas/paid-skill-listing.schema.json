{
  "$id": "https://schemas.runx.ai/runx/marketplace/paid-skill-listing/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable marketplace identity and commercial terms for paid methods in one published skill version. Seller identity is resolved by the authenticated registry boundary and is never accepted from `run.yaml`.",
  "properties": {
    "bundle_digest": {
      "description": "The registry's digest of the published bundle's files.",
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "offers": {
      "additionalProperties": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/PaidSkillMethodOffer"
      },
      "maxProperties": 64,
      "minProperties": 1,
      "propertyNames": {
        "minLength": 1
      },
      "type": "object"
    },
    "profile_digest": {
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "seller_ref": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/PrincipalReference"
    },
    "skill_digest": {
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "skill_id": {
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "skill_id",
    "version",
    "skill_digest",
    "profile_digest",
    "bundle_digest",
    "seller_ref",
    "offers"
  ],
  "title": "PaidSkillListing",
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.marketplace.paid_skill_listing.v1"
}
