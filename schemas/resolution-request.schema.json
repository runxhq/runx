{
  "$id": "https://schemas.runx.ai/runx/resolution-request/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "input",
          "type": "string"
        },
        "questions": {
          "items": {
            "$ref": "https://schemas.runx.ai/runx/question/v1.json"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "id",
        "questions"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "gate": {
          "$ref": "https://schemas.runx.ai/runx/approval-gate/v1.json"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "approval",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "gate"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "invocation": {
          "$ref": "https://schemas.runx.ai/runx/turn-invocation/v1.json"
        },
        "kind": {
          "const": "turn",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "invocation"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "A step or call waits to run again. A bounded retry (`retry_after_seconds` above zero) is runx's own: the driver that reaches it after the delay runs it. A claimed call that never settled (`retry_after_seconds` zero) runs again only on a person's acknowledgement, `{\"retry\": true}`, and only when it can be resent.",
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "retry",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "type": "string"
        },
        "resend": {
          "description": "Whether a claimed call can be sent again with the same input: its provider deduplicates it, or it only reads. One that cannot is never resent; its run can only be closed with the call unconfirmed.",
          "enum": [
            "unsafe"
          ],
          "type": "string"
        },
        "retry_after_seconds": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "reason",
        "retry_after_seconds"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "A call reached a paid method and waits on the person's exact decision: they answer `approved` and the method they pay with (`choice`).",
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "purchase",
          "type": "string"
        },
        "purchase": {
          "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/PurchaseRequest"
        }
      },
      "required": [
        "kind",
        "id",
        "purchase"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "A script's call waits until `until`, in milliseconds since the epoch. Like a bounded retry it's runx's own and takes no answer: whoever resumes the run at or after `until` settles it, and a resume before then settles nothing and reports it again.",
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "wait",
          "type": "string"
        },
        "until": {
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "until"
      ],
      "type": "object"
    }
  ],
  "title": "ResolutionRequest",
  "x-runx-schema": "runx.resolution_request.v1"
}
