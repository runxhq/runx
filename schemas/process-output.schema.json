{
  "$id": "https://schemas.runx.ai/runx/process/output/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What a process wrote after a cursor, as its log keeps it.",
  "properties": {
    "chunks": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/ProcessOutputChunk"
      },
      "type": "array"
    },
    "dropped": {
      "description": "Bytes written before `from` that the log no longer keeps.",
      "minimum": 0,
      "type": "integer"
    },
    "exit": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/ProcessExit"
    },
    "from": {
      "description": "Where this read began: the cursor asked for, or the oldest output the log still keeps when that is later.",
      "minimum": 0,
      "type": "integer"
    },
    "next": {
      "description": "The cursor the next read passes as `after`.",
      "minimum": 0,
      "type": "integer"
    },
    "process_id": {
      "type": "string"
    },
    "state": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/ProcessState"
    }
  },
  "required": [
    "process_id",
    "state",
    "from",
    "next",
    "dropped",
    "chunks"
  ],
  "title": "ProcessOutput",
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.process.output.v1"
}
