{
  "$id": "https://schemas.runx.ai/runx/process/output/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What a process wrote after a cursor, as its log keeps it.",
  "properties": {
    "chunks": {
      "items": {
        "additionalProperties": false,
        "description": "Consecutive output of one stream.",
        "properties": {
          "stream": {
            "description": "A process's stdout or stderr, or the terminal a `tty` process writes to.",
            "enum": [
              "stdout",
              "stderr",
              "terminal"
            ],
            "title": "ProcessStream",
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "stream",
          "text"
        ],
        "title": "ProcessOutputChunk",
        "type": "object"
      },
      "type": "array"
    },
    "dropped": {
      "description": "Bytes written before `from` that the log no longer keeps.",
      "minimum": 0,
      "type": "integer"
    },
    "exit": {
      "additionalProperties": false,
      "description": "How a process ended.",
      "properties": {
        "at": {
          "type": "string"
        },
        "code": {
          "type": "integer"
        },
        "message": {
          "description": "Why it failed, for a process that never ran or whose supervisor ended without recording its exit.",
          "type": "string"
        },
        "reason": {
          "enum": [
            "exited",
            "stopped",
            "timed_out",
            "failed"
          ],
          "title": "ProcessExitReason",
          "type": "string"
        },
        "signal": {
          "type": "integer"
        }
      },
      "required": [
        "reason",
        "at"
      ],
      "title": "ProcessExit",
      "type": "object"
    },
    "from": {
      "description": "Where this read began: the cursor asked for, or the oldest output the log still keeps when that is later.",
      "minimum": 0,
      "type": "integer"
    },
    "next": {
      "description": "The cursor the next read passes as `after`.",
      "minimum": 0,
      "type": "integer"
    },
    "process_id": {
      "type": "string"
    },
    "state": {
      "description": "Where a process stands: recorded and waiting on its supervisor, running under it, or exited.",
      "enum": [
        "starting",
        "running",
        "exited"
      ],
      "title": "ProcessState",
      "type": "string"
    }
  },
  "required": [
    "process_id",
    "state",
    "from",
    "next",
    "dropped",
    "chunks"
  ],
  "title": "ProcessOutput",
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.process.output.v1"
}
