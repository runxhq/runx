{
  "$id": "https://schemas.runx.ai/runx/process/output/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "chunks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "stream": {
            "enum": [
              "stdout",
              "stderr",
              "terminal"
            ],
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "stream",
          "text"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "dropped": {
      "minimum": 0,
      "type": "integer"
    },
    "exit": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "type": "string"
        },
        "code": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "reason": {
          "enum": [
            "exited",
            "stopped",
            "timed_out",
            "failed"
          ],
          "type": "string"
        },
        "signal": {
          "type": "integer"
        }
      },
      "required": [
        "reason",
        "at"
      ],
      "type": "object"
    },
    "from": {
      "minimum": 0,
      "type": "integer"
    },
    "next": {
      "minimum": 0,
      "type": "integer"
    },
    "process_id": {
      "type": "string"
    },
    "state": {
      "enum": [
        "starting",
        "running",
        "exited"
      ],
      "type": "string"
    }
  },
  "required": [
    "process_id",
    "state",
    "from",
    "next",
    "dropped",
    "chunks"
  ],
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.process.output.v1"
}
