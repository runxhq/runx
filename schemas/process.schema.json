{
  "$id": "https://schemas.runx.ai/runx/process/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A process runx supervises apart from any driver: started by one call, and read, written and stopped by later ones until it exits. It belongs to the actor whose run started it.",
  "properties": {
    "actor": {
      "description": "The actor whose runs may read, write and stop it; none for an operator's run.",
      "type": "string"
    },
    "args": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "call": {
      "description": "The call that started it, as its run names it: `<run id>#<step id>@<attempt>`.",
      "type": "string"
    },
    "command": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "cwd": {
      "description": "The absolute directory it runs in.",
      "type": "string"
    },
    "exit": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/ProcessExit"
    },
    "kind": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/ProcessKind"
    },
    "max_seconds": {
      "description": "How long its supervisor lets it run before stopping it.",
      "minimum": 0,
      "type": "integer"
    },
    "pid": {
      "minimum": 0,
      "type": "integer"
    },
    "process_id": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "state": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/ProcessState"
    },
    "tty": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/TerminalSize",
      "description": "The terminal it runs in, when it was given one."
    }
  },
  "required": [
    "process_id",
    "kind",
    "call",
    "command",
    "cwd",
    "max_seconds",
    "created_at",
    "state"
  ],
  "title": "RunxProcess",
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.process.v1"
}
