{
  "$id": "https://schemas.runx.ai/runx/policy/lint/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What `policy.lint` returns: the policy's findings, and its readback when it parsed as a `runx.operational_policy.v1`.",
  "properties": {
    "engine": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/PolicyLintEngine"
    },
    "findings": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/OperationalPolicyValidationFinding"
      },
      "type": "array"
    },
    "readback": {
      "anyOf": [
        {
          "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/OperationalPolicyReadback"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/PolicyLintStatus"
    }
  },
  "required": [
    "status",
    "engine",
    "findings",
    "readback"
  ],
  "title": "PolicyLint",
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.policy.lint.v1"
}
