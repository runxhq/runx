          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "anyOf": [
        {
          "additionalProperties": {},
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "resource": {
      "$ref": "https://schemas.runx.ai/external/x402/v2/resource-info.schema.json"
    },
    "x402Version": {
      "const": 2,
      "type": "integer"
    }
  },
  "required": [
