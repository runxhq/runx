{
  "$id": "https://schemas.runx.ai/runx/skill/inspect/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "catalog": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/SkillCatalog"
    },
    "connector_readiness": {
      "description": "Each operation the method may call, as ready as the project leaves it.",
      "items": {
        "$ref": "https://schemas.runx.ai/runx/readiness/v1.json"
      },
      "minItems": 1,
      "type": "array"
    },
    "description": {
      "type": "string"
    },
    "entry_provenance": {
      "additionalProperties": {},
      "description": "Where the inspected package came from, when a resolver found it.",
      "type": "object"
    },
    "environment": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/EnvironmentReadiness",
      "description": "The environment the method reads, by name and availability, never by value."
    },
    "examples": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "execution_closure": {
      "additionalProperties": {},
      "type": "object"
    },
    "manual_digest": {
      "type": "string"
    },
    "method": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/MethodInspection",
      "description": "The method inspected: the one named, else the default."
    },
    "method_inspections": {
      "description": "Each method with the execution closure it binds.",
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/MethodInspectionEntry"
      },
      "minItems": 1,
      "type": "array"
    },
    "methods": {
      "description": "Every method the package declares, by name.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "name": {
      "type": "string"
    },
    "package_digest": {
      "description": "The execution package digest, as a run records it; a listing's package digest is the registry's digest of the published files.",
      "type": "string"
    },
    "readiness": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/InspectionReadiness"
    },
    "resume": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/InspectionResume"
    },
    "schema": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/SkillInspectionSchema"
    },
    "skill_path": {
      "type": "string"
    },
    "status": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/SkillInspectionStatus"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "status",
    "name",
    "skill_path",
    "manual_digest",
    "package_digest",
    "methods"
  ],
  "title": "SkillInspection",
  "type": "object",
  "x-runx-schema": "runx.skill.inspect.v1"
}
