{
  "$id": "https://schemas.runx.ai/runx/fs/file-search/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What `fs.search` returns: each matching line, with its context and its file's digest.",
  "properties": {
    "files_searched": {
      "minimum": 0,
      "type": "integer"
    },
    "matches": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/FileSearchMatch"
      },
      "maxItems": 1000,
      "minItems": 0,
      "type": "array"
    },
    "repo_root": {
      "minLength": 1,
      "type": "string"
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "repo_root",
    "matches",
    "files_searched",
    "truncated"
  ],
  "title": "FileSearch",
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.fs.file_search.v1"
}
