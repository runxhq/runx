{
  "$id": "https://schemas.runx.ai/runx/fs/file-search/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What `fs.search` returns: each matching line, with its context and its file's digest.",
  "properties": {
    "files_searched": {
      "minimum": 0,
      "type": "integer"
    },
    "matches": {
      "items": {
        "additionalProperties": false,
        "description": "One line `fs.search` matched.",
        "properties": {
          "after": {
            "items": {
              "type": "string"
            },
            "maxItems": 3,
            "minItems": 0,
            "type": "array"
          },
          "before": {
            "items": {
              "type": "string"
            },
            "maxItems": 3,
            "minItems": 0,
            "type": "array"
          },
          "content_digest": {
            "description": "The whole file's digest, which a write of it names.",
            "maxLength": 71,
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "line": {
            "minimum": 1,
            "type": "integer"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "line",
          "text",
          "before",
          "after",
          "content_digest"
        ],
        "title": "FileSearchMatch",
        "type": "object"
      },
      "maxItems": 1000,
      "minItems": 0,
      "type": "array"
    },
    "repo_root": {
      "minLength": 1,
      "type": "string"
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "repo_root",
    "matches",
    "files_searched",
    "truncated"
  ],
  "title": "FileSearch",
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.fs.file_search.v1"
}
