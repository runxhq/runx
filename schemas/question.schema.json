{
  "$id": "https://schemas.runx.ai/runx/question/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "description": {
      "type": "string"
    },
    "free_text": {
      "const": true,
      "description": "Whether the person may answer in their own words.",
      "type": "boolean"
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "options": {
      "description": "What the person may choose, the recommended first.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "type": "string"
          },
          "label": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "label"
        ],
        "title": "QuestionOption",
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "prompt": {
      "minLength": 1,
      "type": "string"
    },
    "required": {
      "type": "boolean"
    },
    "type": {
      "description": "`choice` when it offers options, `text` otherwise.",
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "id",
    "prompt",
    "required",
    "type"
  ],
  "title": "Question",
  "type": "object",
  "x-runx-schema": "runx.question.v1"
}
