{
  "$id": "https://schemas.runx.ai/runx/connector-binding/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "connector": {
      "maxLength": 129,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?/[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$",
      "type": "string"
    },
    "connector_digest": {
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "manifest_digest": {
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "connector",
    "manifest_digest",
    "connector_digest"
  ],
  "type": "object",
  "x-runx-schema": "runx.connector_binding.v1"
}
