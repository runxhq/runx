{
  "$id": "https://schemas.runx.ai/runx/skill/change-draft/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Agent-authored package bytes and intent before the runtime binds them to an inspected package state. This contract deliberately contains no digest: agents never calculate or copy runtime integrity values.",
  "properties": {
    "decision": {
      "enum": [
        "write",
        "no_skill",
        "no_change",
        "needs_core"
      ],
      "title": "SkillChangeDecision",
      "type": "string"
    },
    "deletes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "expected_outputs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "packet": {
            "maxLength": 200,
            "pattern": "^(runx|[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?/[a-z0-9]+(?:-[a-z0-9]+)*)(\\.[a-z][a-z0-9_]*)+\\.v[1-9][0-9]*$",
            "type": "string"
          },
          "value_type": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name",
          "value_type"
        ],
        "title": "SkillExpectedOutput",
        "type": "object"
      },
      "type": "array"
    },
    "non_goals": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "schema": {
      "enum": [
        "runx.skill.change_draft.v1"
      ],
      "title": "SkillChangeDraftSchema",
      "type": "string"
    },
    "summary": {
      "minLength": 1,
      "type": "string"
    },
    "writes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "contents": {
            "type": "string"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "path",
          "contents"
        ],
        "title": "SkillFileWrite",
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "decision",
    "summary",
    "non_goals",
    "writes",
    "deletes",
    "expected_outputs"
  ],
  "title": "SkillChangeDraft",
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.skill.change_draft.v1"
}
