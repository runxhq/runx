{
  "$id": "https://schemas.runx.ai/runx/skill/change-draft/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Agent-authored package bytes and intent before the runtime binds them to an inspected package state. This contract deliberately contains no digest: agents never calculate or copy runtime integrity values.",
  "properties": {
    "decision": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/SkillChangeDecision"
    },
    "deletes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "expected_outputs": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/SkillExpectedOutput"
      },
      "type": "array"
    },
    "non_goals": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "schema": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/SkillChangeDraftSchema"
    },
    "summary": {
      "minLength": 1,
      "type": "string"
    },
    "writes": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/SkillFileWrite"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "decision",
    "summary",
    "non_goals",
    "writes",
    "deletes",
    "expected_outputs"
  ],
  "title": "SkillChangeDraft",
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.skill.change_draft.v1"
}
