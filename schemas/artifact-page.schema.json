{
  "$id": "https://schemas.runx.ai/runx/artifact-page/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One bounded page read of an artifact.",
  "properties": {
    "data": {
      "type": "string"
    },
    "digest": {
      "description": "The digest of the whole artifact's bytes.",
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "encoding": {
      "minLength": 1,
      "type": "string"
    },
    "eof": {
      "type": "boolean"
    },
    "length": {
      "minimum": 0,
      "type": "integer"
    },
    "next_offset": {
      "minimum": 0,
      "type": "integer"
    },
    "offset": {
      "minimum": 0,
      "type": "integer"
    },
    "range_digest": {
      "description": "The digest of this page's bytes.",
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "records": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "ref": {
      "description": "The artifact the page is of.",
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "ref",
    "offset",
    "length",
    "next_offset",
    "eof",
    "range_digest",
    "digest",
    "encoding"
  ],
  "title": "ArtifactPage",
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.artifact_page.v1"
}
