{
  "$id": "https://schemas.runx.ai/runx/fs/file-read-bundle/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What `fs.read_bundle` returns: each file it read whole, and each it could not read when the call asked for the missing to be reported.",
  "properties": {
    "file_count": {
      "maximum": 16,
      "minimum": 0,
      "type": "integer"
    },
    "files": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/fs/file-read/v1.json"
      },
      "maxItems": 16,
      "minItems": 0,
      "type": "array"
    },
    "missing": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/MissingFile"
      },
      "maxItems": 16,
      "minItems": 0,
      "type": "array"
    },
    "repo_root": {
      "minLength": 1,
      "type": "string"
    },
    "total_bytes": {
      "maximum": 33554432,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "repo_root",
    "file_count",
    "total_bytes",
    "files",
    "missing"
  ],
  "title": "FileReadBundle",
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.fs.file_read_bundle.v1"
}
