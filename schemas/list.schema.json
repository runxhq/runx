{
  "$id": "https://schemas.runx.ai/runx/list/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "description": "A skill's description, from the frontmatter of its own `SKILL.md`.",
            "type": "string"
          },
          "diagnostics": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "emits": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "packet": {
                  "maxLength": 200,
                  "pattern": "^(runx|[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?/[a-z0-9]+(?:-[a-z0-9]+)*)(\\.[a-z][a-z0-9_]*)+\\.v[1-9][0-9]*$",
                  "type": "string"
                }
              },
              "required": [
                "name"
              ],
              "title": "RunxListEmit",
              "type": "object"
            },
            "type": "array"
          },
          "fixtures": {
            "minimum": 0,
            "type": "integer"
          },
          "harness_cases": {
            "minimum": 0,
            "type": "integer"
          },
          "kind": {
            "enum": [
              "tool",
              "skill",
              "graph",
              "packet",
              "overlay"
            ],
            "title": "RunxListItemKind",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "runners": {
            "description": "A skill's runners, each with its purpose when its `run.yaml` states one.",
            "items": {
              "additionalProperties": false,
              "description": "One runner of a skill, as a model chooses it from an index.",
              "properties": {
                "name": {
                  "type": "string"
                },
                "purpose": {
                  "description": "What it does and when to use it, as its package states it.",
                  "type": "string"
                }
              },
              "required": [
                "name"
              ],
              "title": "CatalogRunner",
              "type": "object"
            },
            "type": "array"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "source": {
            "enum": [
              "local",
              "workspace",
              "dependencies",
              "built-in"
            ],
            "title": "RunxListSource",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "invalid"
            ],
            "title": "RunxListStatus",
            "type": "string"
          },
          "steps": {
            "minimum": 0,
            "type": "integer"
          },
          "visibility": {
            "description": "A skill's catalog visibility; public when its manifest declares none.",
            "enum": [
              "public",
              "internal"
            ],
            "title": "RunxListVisibility",
            "type": "string"
          },
          "wraps": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "name",
          "source",
          "path",
          "status"
        ],
        "title": "RunxListItem",
        "type": "object"
      },
      "type": "array"
    },
    "requested_kind": {
      "enum": [
        "all",
        "tools",
        "skills",
        "graphs",
        "packets",
        "overlays"
      ],
      "title": "RunxListRequestedKind",
      "type": "string"
    },
    "root": {
      "type": "string"
    },
    "schema": {
      "enum": [
        "runx.list.v1"
      ],
      "title": "RunxListSchema",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "root",
    "requested_kind",
    "items"
  ],
  "title": "RunxListReport",
  "type": "object",
  "x-runx-schema": "runx.list.v1"
}
