{
  "$id": "https://schemas.runx.ai/runx/agent-context-envelope/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "act": {
      "additionalProperties": false,
      "description": "The act its run's invoker stated: why the run exists, as the run's steps read `$act`.",
      "properties": {
        "decision": {
          "description": "The decision the call carries out.",
          "enum": [
            "continue",
            "escalate",
            "defer",
            "close",
            "decline",
            "monitor"
          ],
          "title": "DecisionChoice",
          "type": "string"
        },
        "form": {
          "description": "What kind of act the call is.",
          "enum": [
            "reply",
            "review"
          ],
          "type": "string"
        },
        "previous": {
          "description": "The receipt of the act this one follows.",
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "purpose": {
          "description": "Why the call is made.",
          "minLength": 1,
          "type": "string"
        },
        "reason": {
          "description": "What a reader is told about this particular call.",
          "minLength": 1,
          "type": "string"
        },
        "target": {
          "description": "The locator of what the act is about.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "purpose"
      ],
      "title": "CallAct",
      "type": "object"
    },
    "context": {
      "additionalProperties": false,
      "description": "The optional conventions and project instructions context block.",
      "properties": {
        "conventions": {
          "additionalProperties": false,
          "description": "A resolved profile sourced from a workspace file (memory, conventions, voice).",
          "properties": {
            "content": {
              "type": "string"
            },
            "digest": {
              "minLength": 1,
              "type": "string"
            },
            "path": {
              "minLength": 1,
              "type": "string"
            },
            "root_path": {
              "minLength": 1,
              "type": "string"
            },
            "sharing": {
              "enum": [
                "local_only",
                "configured_model"
              ],
              "title": "ContextSharing",
              "type": "string"
            }
          },
          "required": [
            "sharing",
            "root_path",
            "path",
            "digest",
            "content"
          ],
          "title": "ProfileFile",
          "type": "object"
        },
        "instructions": {
          "description": "The project's instructions: each `AGENTS.md` and `CLAUDE.md` from the repository root that contains the workspace down to the workspace, in that order, each `path` relative to the repository root.",
          "items": {
            "additionalProperties": false,
            "description": "A resolved profile sourced from a workspace file (memory, conventions, voice).",
            "properties": {
              "content": {
                "type": "string"
              },
              "digest": {
                "minLength": 1,
                "type": "string"
              },
              "path": {
                "minLength": 1,
                "type": "string"
              },
              "root_path": {
                "minLength": 1,
                "type": "string"
              },
              "sharing": {
                "enum": [
                  "local_only",
                  "configured_model"
                ],
                "title": "ContextSharing",
                "type": "string"
              }
            },
            "required": [
              "sharing",
              "root_path",
              "path",
              "digest",
              "content"
            ],
            "title": "ProfileFile",
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "memory": {
          "additionalProperties": false,
          "description": "The workspace's `MEMORY.md`, in envelopes recorded before hosts carried memory themselves. runx writes none: memory a host supplies travels as admitted context entries.",
          "properties": {
            "content": {
              "type": "string"
            },
            "digest": {
              "minLength": 1,
              "type": "string"
            },
            "path": {
              "minLength": 1,
              "type": "string"
            },
            "root_path": {
              "minLength": 1,
              "type": "string"
            },
            "sharing": {
              "enum": [
                "local_only",
                "configured_model"
              ],
              "title": "ContextSharing",
              "type": "string"
            }
          },
          "required": [
            "sharing",
            "root_path",
            "path",
            "digest",
            "content"
          ],
          "title": "ProfileFile",
          "type": "object"
        }
      },
      "title": "AgentContextProfiles",
      "type": "object"
    },
    "current_context": {
      "items": {
        "additionalProperties": false,
        "description": "A single artifact context entry. `type` is required-but-nullable.",
        "properties": {
          "data": {
            "additionalProperties": {},
            "type": "object"
          },
          "meta": {
            "additionalProperties": false,
            "description": "Metadata for a context artifact. `step_id`, `parent_artifact_id`, and `receipt_id` are required-but-nullable (present on the wire, possibly null).",
            "properties": {
              "artifact_id": {
                "minLength": 1,
                "type": "string"
              },
              "created_at": {
                "minLength": 1,
                "type": "string"
              },
              "digest": {
                "minLength": 1,
                "type": "string"
              },
              "parent_artifact_id": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "producer": {
                "additionalProperties": false,
                "description": "The producer of a context artifact.",
                "properties": {
                  "runner": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "skill": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "skill",
                  "runner"
                ],
                "title": "ContextArtifactProducer",
                "type": "object"
              },
              "receipt_id": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "redacted": {
                "type": "boolean"
              },
              "run_id": {
                "minLength": 1,
                "type": "string"
              },
              "size_bytes": {
                "minimum": 0,
                "type": "integer"
              },
              "step_id": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "artifact_id",
              "run_id",
              "step_id",
              "producer",
              "created_at",
              "digest",
              "size_bytes",
              "parent_artifact_id",
              "receipt_id",
              "redacted"
            ],
            "title": "ContextArtifactMeta",
            "type": "object"
          },
          "scope": {
            "additionalProperties": false,
            "description": "Declares how context may be interpreted and where it may be shared. These labels never grant execution authority or manufacture a human decision.",
            "properties": {
              "goal_id": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "purpose": {
                "enum": [
                  "procedure",
                  "mandate",
                  "confirmed_memory",
                  "observation",
                  "work_continuity",
                  "retrieved_history",
                  "hypothesis"
                ],
                "title": "ContextPurpose",
                "type": "string"
              },
              "sharing": {
                "enum": [
                  "local_only",
                  "configured_model"
                ],
                "title": "ContextSharing",
                "type": "string"
              },
              "source_uri": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "trust": {
                "enum": [
                  "operator_confirmed",
                  "skill_instructions",
                  "untrusted_evidence"
                ],
                "title": "ContextTrust",
                "type": "string"
              }
            },
            "required": [
              "purpose",
              "trust",
              "sharing",
              "goal_id",
              "source_uri"
            ],
            "title": "ContextScope",
            "type": "object"
          },
          "summary": {
            "description": "What the entry is, in a line, as its producer declares it: what a model reads in an index to choose whether to read the entry's data.",
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "version": {
            "description": "The artifact context entry version. Committed as `const: \"1\"`.",
            "enum": [
              "1"
            ],
            "title": "ContextEntryVersion",
            "type": "string"
          }
        },
        "required": [
          "type",
          "version",
          "scope",
          "data",
          "meta"
        ],
        "title": "ContextEntry",
        "type": "object"
      },
      "type": "array"
    },
    "execution_location": {
      "additionalProperties": false,
      "description": "Where the skill executes from on disk.",
      "properties": {
        "skill_directory": {
          "minLength": 1,
          "type": "string"
        },
        "tool_roots": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "skill_directory"
      ],
      "title": "ExecutionLocation",
      "type": "object"
    },
    "historical_context": {
      "items": {
        "additionalProperties": false,
        "description": "A single artifact context entry. `type` is required-but-nullable.",
        "properties": {
          "data": {
            "additionalProperties": {},
            "type": "object"
          },
          "meta": {
            "additionalProperties": false,
            "description": "Metadata for a context artifact. `step_id`, `parent_artifact_id`, and `receipt_id` are required-but-nullable (present on the wire, possibly null).",
            "properties": {
              "artifact_id": {
                "minLength": 1,
                "type": "string"
              },
              "created_at": {
                "minLength": 1,
                "type": "string"
              },
              "digest": {
                "minLength": 1,
                "type": "string"
              },
              "parent_artifact_id": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "producer": {
                "additionalProperties": false,
                "description": "The producer of a context artifact.",
                "properties": {
                  "runner": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "skill": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "skill",
                  "runner"
                ],
                "title": "ContextArtifactProducer",
                "type": "object"
              },
              "receipt_id": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "redacted": {
                "type": "boolean"
              },
              "run_id": {
                "minLength": 1,
                "type": "string"
              },
              "size_bytes": {
                "minimum": 0,
                "type": "integer"
              },
              "step_id": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "artifact_id",
              "run_id",
              "step_id",
              "producer",
              "created_at",
              "digest",
              "size_bytes",
              "parent_artifact_id",
              "receipt_id",
              "redacted"
            ],
            "title": "ContextArtifactMeta",
            "type": "object"
          },
          "scope": {
            "additionalProperties": false,
            "description": "Declares how context may be interpreted and where it may be shared. These labels never grant execution authority or manufacture a human decision.",
            "properties": {
              "goal_id": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "purpose": {
                "enum": [
                  "procedure",
                  "mandate",
                  "confirmed_memory",
                  "observation",
                  "work_continuity",
                  "retrieved_history",
                  "hypothesis"
                ],
                "title": "ContextPurpose",
                "type": "string"
              },
              "sharing": {
                "enum": [
                  "local_only",
                  "configured_model"
                ],
                "title": "ContextSharing",
                "type": "string"
              },
              "source_uri": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "trust": {
                "enum": [
                  "operator_confirmed",
                  "skill_instructions",
                  "untrusted_evidence"
                ],
                "title": "ContextTrust",
                "type": "string"
              }
            },
            "required": [
              "purpose",
              "trust",
              "sharing",
              "goal_id",
              "source_uri"
            ],
            "title": "ContextScope",
            "type": "object"
          },
          "summary": {
            "description": "What the entry is, in a line, as its producer declares it: what a model reads in an index to choose whether to read the entry's data.",
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "version": {
            "description": "The artifact context entry version. Committed as `const: \"1\"`.",
            "enum": [
              "1"
            ],
            "title": "ContextEntryVersion",
            "type": "string"
          }
        },
        "required": [
          "type",
          "version",
          "scope",
          "data",
          "meta"
        ],
        "title": "ContextEntry",
        "type": "object"
      },
      "type": "array"
    },
    "inputs": {
      "additionalProperties": {},
      "type": "object"
    },
    "instructions": {
      "minLength": 1,
      "type": "string"
    },
    "instructions_digest": {
      "description": "Digest of the exact owning `SKILL.md` bytes carried in `instructions`.",
      "minLength": 1,
      "type": "string"
    },
    "output": {
      "additionalProperties": {
        "anyOf": [
          {
            "description": "A declared output value type.",
            "enum": [
              "string",
              "number",
              "integer",
              "boolean",
              "array",
              "object",
              "null"
            ],
            "title": "OutputType",
            "type": "string"
          },
          {
            "additionalProperties": false,
            "description": "The expanded form of an output field declaration. Committed with `additionalProperties: false` and `minProperties: 1` (the latter is a numeric bound the emitter does not express).",
            "properties": {
              "description": {
                "type": "string"
              },
              "enum": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "required": {
                "type": "boolean"
              },
              "schema": {
                "additionalProperties": {},
                "description": "Additional JSON Schema 2020-12 keywords for this output value. The scalar type, description, and enum above remain the canonical top-level declaration; this object owns nested shape and bounds.",
                "type": "object"
              },
              "type": {
                "description": "A declared output value type.",
                "enum": [
                  "string",
                  "number",
                  "integer",
                  "boolean",
                  "array",
                  "object",
                  "null"
                ],
                "title": "OutputType",
                "type": "string"
              },
              "wrap_as": {
                "minLength": 1,
                "type": "string"
              }
            },
            "title": "OutputFieldSpec",
            "type": "object"
          }
        ],
        "description": "A single output field declaration: either a bare type name or a typed spec.",
        "title": "OutputField"
      },
      "type": "object"
    },
    "output_schema": {
      "description": "Exact root JSON Schema for the final result, including any declared packet contract. `output` remains the concise field index used by hosts; this schema is the validator offered to managed agents."
    },
    "provenance": {
      "items": {
        "additionalProperties": false,
        "description": "One input/output provenance edge.",
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "from_step": {
            "type": "string"
          },
          "input": {
            "minLength": 1,
            "type": "string"
          },
          "output": {
            "minLength": 1,
            "type": "string"
          },
          "receipt_id": {
            "type": "string"
          }
        },
        "required": [
          "input",
          "output"
        ],
        "title": "ProvenanceEntry",
        "type": "object"
      },
      "type": "array"
    },
    "requirements": {
      "additionalProperties": false,
      "description": "Exact non-secret execution requirements selected from the owning manifest, plus environment-name availability. Secret values never enter the agent context.",
      "properties": {
        "declaration": {
          "additionalProperties": false,
          "description": "Parser-owned projection of all execution requirements for one act.",
          "properties": {
            "environment": {
              "additionalProperties": false,
              "description": "Environment names consumed by an executable act. Values are resolved only at execution time and never enter this declaration.",
              "minProperties": 1,
              "properties": {
                "optional": {
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array"
                },
                "required": {
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array"
                }
              },
              "type": "object"
            },
            "scopes": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "title": "ExecutionRequirements",
          "type": "object"
        },
        "environment": {
          "items": {
            "additionalProperties": false,
            "description": "Safe environment readiness visible to an operating agent. The value is deliberately absent: models receive the requirement and its availability, never ambient or credential material.",
            "properties": {
              "available": {
                "type": "boolean"
              },
              "name": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "required",
              "available"
            ],
            "title": "EnvironmentRequirementStatus",
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "execution_boundary": {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "trusted_host_process",
                "deterministic_worker",
                "native_capability",
                "remote_provider"
              ],
              "title": "ExecutionBoundaryKind",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "title": "ExecutionBoundaryObservation",
          "type": "object"
        }
      },
      "required": [
        "declaration",
        "execution_boundary"
      ],
      "title": "AgentExecutionRequirements",
      "type": "object"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "skill": {
      "minLength": 1,
      "type": "string"
    },
    "step_id": {
      "minLength": 1,
      "type": "string"
    },
    "trust_boundary": {
      "minLength": 1,
      "type": "string"
    },
    "voice_profile": {
      "additionalProperties": false,
      "description": "A resolved profile sourced from a workspace file (memory, conventions, voice).",
      "properties": {
        "content": {
          "type": "string"
        },
        "digest": {
          "minLength": 1,
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "root_path": {
          "minLength": 1,
          "type": "string"
        },
        "sharing": {
          "enum": [
            "local_only",
            "configured_model"
          ],
          "title": "ContextSharing",
          "type": "string"
        }
      },
      "required": [
        "sharing",
        "root_path",
        "path",
        "digest",
        "content"
      ],
      "title": "ProfileFile",
      "type": "object"
    }
  },
  "required": [
    "run_id",
    "skill",
    "instructions_digest",
    "instructions",
    "inputs",
    "requirements",
    "current_context",
    "historical_context",
    "provenance",
    "trust_boundary"
  ],
  "title": "AgentContextEnvelope",
  "type": "object",
  "x-runx-schema": "runx.agent_context_envelope.v1"
}
