{
  "$id": "https://schemas.runx.ai/runx/agent-context-envelope/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "act": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/CallAct",
      "description": "The act its run's invoker stated: why the run exists, as the run's steps read `$run.act`."
    },
    "context": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/AgentContextProfiles"
    },
    "current_context": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/context-entry/v1.json"
      },
      "type": "array"
    },
    "execution_location": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/ExecutionLocation"
    },
    "historical_context": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/context-entry/v1.json"
      },
      "type": "array"
    },
    "inputs": {
      "additionalProperties": {},
      "type": "object"
    },
    "instructions": {
      "minLength": 1,
      "type": "string"
    },
    "instructions_digest": {
      "description": "Digest of the exact bytes carried in `instructions`.",
      "minLength": 1,
      "type": "string"
    },
    "output": {
      "additionalProperties": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/OutputField"
      },
      "type": "object"
    },
    "output_schema": {
      "description": "Exact root JSON Schema for the final result, including any declared packet contract. `output` remains the concise field index used by hosts; this schema is the validator offered to managed agents."
    },
    "provenance": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/ProvenanceEntry"
      },
      "type": "array"
    },
    "requirements": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/AgentExecutionRequirements",
      "description": "Exact non-secret execution requirements selected from the owning manifest, plus environment-name availability. Secret values never enter the agent context."
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "skill": {
      "minLength": 1,
      "type": "string"
    },
    "step_id": {
      "minLength": 1,
      "type": "string"
    },
    "trust_boundary": {
      "minLength": 1,
      "type": "string"
    },
    "voice_profile": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/ProfileFile"
    }
  },
  "required": [
    "run_id",
    "skill",
    "instructions_digest",
    "instructions",
    "inputs",
    "requirements",
    "current_context",
    "historical_context",
    "provenance",
    "trust_boundary"
  ],
  "title": "AgentContextEnvelope",
  "type": "object",
  "x-runx-schema": "runx.agent_context_envelope.v1"
}
