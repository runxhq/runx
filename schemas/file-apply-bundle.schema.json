{
  "$id": "https://schemas.runx.ai/runx/fs/apply-bundle/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What `fs.apply_bundle` returns: each file it wrote and each it deleted.",
  "properties": {
    "delete_count": {
      "minimum": 0,
      "type": "integer"
    },
    "deletes": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/FileAppliedDelete"
      },
      "type": "array"
    },
    "journal": {
      "description": "The run's journal entry holding what each file held before.",
      "minimum": 1,
      "type": "integer"
    },
    "repo_root": {
      "minLength": 1,
      "type": "string"
    },
    "write_count": {
      "minimum": 0,
      "type": "integer"
    },
    "writes": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/FileAppliedWrite"
      },
      "type": "array"
    }
  },
  "required": [
    "repo_root",
    "write_count",
    "delete_count",
    "writes",
    "deletes"
  ],
  "title": "FileApplyBundle",
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.fs.apply_bundle.v1"
}
