{
  "$id": "https://schemas.runx.ai/runx/turn-status/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An open turn as its agent reads it: the act it answers (its id is the turn's address), with the act's context as an index, the calls it may make, and how each call it made so far ended. Nothing in it is the data of a context entry, which `turn_read` reads by its locator.",
  "properties": {
    "calls": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/turn-call/v1.json"
      },
      "type": "array"
    },
    "invocation": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/TurnView"
    },
    "tools": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/TurnTool"
      },
      "type": "array"
    }
  },
  "required": [
    "invocation",
    "tools",
    "calls"
  ],
  "title": "TurnStatus",
  "type": "object",
  "x-runx-schema": "runx.turn_status.v1"
}
