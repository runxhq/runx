{
  "$id": "https://schemas.runx.ai/runx/skill/change-bundle/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "architecture": {
      "$ref": "https://schemas.runx.ai/runx/skill/architecture-decision/v1.json"
    },
    "base_digest": {
      "minLength": 1,
      "type": "string"
    },
    "decision": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/SkillChangeDecision"
    },
    "deletes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "expected_outputs": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/SkillExpectedOutput"
      },
      "type": "array"
    },
    "non_goals": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "plan_digest": {
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/SkillChangeBundleSchema"
    },
    "summary": {
      "minLength": 1,
      "type": "string"
    },
    "writes": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/SkillFileWrite"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "decision",
    "base_digest",
    "plan_digest",
    "architecture",
    "summary",
    "non_goals",
    "writes",
    "deletes",
    "expected_outputs"
  ],
  "title": "SkillChangeBundle",
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.skill.change_bundle.v1"
}
