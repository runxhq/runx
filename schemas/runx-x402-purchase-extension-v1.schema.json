{
  "$id": "https://schemas.runx.ai/runx/x402/purchase-extension/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "additionalProperties": false,
      "properties": {
        "bundle_digest": {
          "description": "The registry's digest of the published bundle's files.",
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "offer_version": {
          "$ref": "https://schemas.runx.ai/runx/payment/offer-version-binding/v1.json"
        },
        "purpose": {
          "const": "discovery",
          "type": "string"
        }
      },
      "required": [
        "purpose",
        "offer_version",
        "bundle_digest"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "canonicalizer_version": {
          "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/PurchaseCanonicalizerVersion"
        },
        "idempotency": {
          "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/PaymentIdempotencyBinding"
        },
        "input_digest": {
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "offer_version": {
          "$ref": "https://schemas.runx.ai/runx/payment/offer-version-binding/v1.json"
        },
        "package_digest": {
          "description": "The execution package digest the purchase runs (`runx.skill-package.v1` over the files a run loads).",
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "purchase_id": {
          "minLength": 1,
          "type": "string"
        },
        "purpose": {
          "const": "purchase",
          "type": "string"
        },
        "quote_ref": {
          "$ref": "https://schemas.runx.ai/runx/reference/v1.json"
        }
      },
      "required": [
        "purpose",
        "purchase_id",
        "quote_ref",
        "offer_version",
        "package_digest",
        "input_digest",
        "canonicalizer_version",
        "idempotency"
      ],
      "type": "object"
    }
  ],
  "description": "Strict Runx information advertised under the external `runx.purchase` key.\n\nThis is a declaration only. The authoritative challenge binding remains the `PurchasePaymentChallenge` `quote_ref` and `payload_digest` pair.",
  "title": "RunxX402PurchaseExtensionInfo",
  "x-runx-schema": "runx.x402.purchase_extension.v1"
}
