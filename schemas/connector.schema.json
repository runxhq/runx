{
  "$id": "https://schemas.runx.ai/runx/connector/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One provider's operations and how runx reaches them.",
  "properties": {
    "auth": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/ConnectorAuth"
    },
    "category": {
      "description": "The connector category it declares from the registry taxonomy (`registry/taxonomy.json`); a connector that declares none is uncategorized.",
      "minLength": 1,
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "type": "string"
    },
    "name": {
      "description": "The connector's whole name: `stripe`, `google/calendar`.",
      "maxLength": 129,
      "pattern": "^(?!versions(?:/|$))[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?(?:/(?!versions$)[a-z][a-z0-9-]{0,62}[a-z0-9])?$",
      "type": "string"
    },
    "operations": {
      "additionalProperties": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/ConnectorOperation"
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
      },
      "type": "object"
    },
    "parameters": {
      "additionalProperties": {},
      "description": "The JSON Schema of what an instance pins besides its authority, such as a store's location. Templates bind them as `$parameter`.",
      "type": "object"
    },
    "payment": {
      "additionalProperties": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/PaymentCompatibility"
      },
      "description": "What a payment connector pays with, so a purchase offers it as a method only for a quote it can pay (S8, N10).",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
      },
      "type": "object"
    },
    "placements": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/ConnectorPlacements"
    },
    "references": {
      "description": "What the connector's locators name, so references to them are classified without the runtime knowing the provider.",
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/ReferenceDeclaration"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/ConnectorSchema"
    },
    "title": {
      "description": "Its display name, such as \"GitHub\".",
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema",
    "name",
    "title",
    "description",
    "auth",
    "placements",
    "operations"
  ],
  "title": "ConnectorManifest",
  "type": "object",
  "x-runx-schema": "runx.connector.v1"
}
