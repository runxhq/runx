{
  "$id": "https://schemas.runx.ai/runx/approval/decision/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "enum": [
        "human",
        "agent"
      ],
      "type": "string"
    },
    "approved": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "gate_id": {
      "type": "string"
    },
    "gate_type": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "schema": {
      "const": "runx.approval.decision.v1",
      "type": "string"
    },
    "status": {
      "enum": [
        "approved",
        "denied",
        "pending"
      ],
      "type": "string"
    }
  },
  "required": [
    "approved",
    "gate_id",
    "idempotency_key",
    "status"
  ],
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.approval.decision.v1"
}
