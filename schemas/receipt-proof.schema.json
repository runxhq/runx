{
  "$id": "https://schemas.runx.ai/runx/receipt/proof/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What `receipt.proof` returns: each requested receipt it found, its redacted detail, and the verification of every tree.",
  "properties": {
    "decision": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/ReceiptProofDecision"
    },
    "matched_receipts": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/MatchedReceipt"
      },
      "maxItems": 100,
      "minItems": 0,
      "type": "array"
    },
    "receipt_details": {
      "items": {
        "additionalProperties": {},
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 0,
      "type": "array"
    },
    "requested_receipt_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "schema": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/ReceiptProofSchema"
    },
    "store": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/ReceiptProofStore"
    },
    "verification": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/ReceiptProofVerification"
    }
  },
  "required": [
    "schema",
    "decision",
    "requested_receipt_ids",
    "matched_receipts",
    "receipt_details",
    "verification",
    "store"
  ],
  "title": "ReceiptProof",
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.receipt.proof.v1"
}
