{
  "$id": "https://schemas.runx.ai/runx/skill-run/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/project-artifact/v1.json"
      },
      "type": "array"
    },
    "context": {
      "description": "The run's operator context and step trace, written only with `--diagnostics`; otherwise they live behind `diagnostics_artifact`."
    },
    "diagnostics_artifact": {
      "$ref": "https://schemas.runx.ai/runx/project-artifact/v1.json"
    },
    "entry_provenance": {
      "additionalProperties": {},
      "description": "Where the skill the run started came from, as the CLI resolved it.",
      "type": "object"
    },
    "error": {
      "additionalProperties": {},
      "description": "A failed run's exit code and message.",
      "type": "object"
    },
    "method": {
      "type": "string"
    },
    "next": {
      "description": "The command that continues a paused run.",
      "type": "string"
    },
    "outcome": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/RunOutcome",
      "description": "How the run ended: its seal's outcome, or `deferred` while it waits."
    },
    "receipt_id": {
      "type": "string"
    },
    "refusal": {
      "additionalProperties": {},
      "description": "Why a guard or an authority refused the run, when one did.",
      "type": "object"
    },
    "request_set_artifact": {
      "$ref": "https://schemas.runx.ai/runx/project-artifact/v1.json"
    },
    "requests": {
      "items": {},
      "type": "array"
    },
    "result": {},
    "run_id": {
      "type": "string"
    },
    "schema": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/SkillOutputSchema"
    },
    "seal_reason": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/SealReason",
      "description": "Why the seal ended the run so, where the outcome alone does not say."
    },
    "skill_name": {
      "type": "string"
    },
    "status": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/SkillOutputStatus"
    },
    "trace": {}
  },
  "required": [
    "status"
  ],
  "title": "SkillOutput",
  "type": "object",
  "x-runx-schema": "runx.skill_run.v1"
}
