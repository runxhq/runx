{
  "$id": "https://schemas.runx.ai/runx/turn-invocation/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowance": {
      "additionalProperties": false,
      "description": "What the agent may call while its turn is open.",
      "properties": {
        "asks": {
          "const": true,
          "description": "Whether the turn may ask the human.",
          "type": "boolean"
        },
        "operations": {
          "items": {
            "additionalProperties": false,
            "description": "One connector operation a turn may call, named by the requirement that binds its instance.",
            "properties": {
              "operation": {
                "minLength": 1,
                "type": "string"
              },
              "requirement": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "requirement",
              "operation"
            ],
            "title": "AllowedOperation",
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "skills": {
          "description": "Child skills by ref, and the catalog rules a load is admitted under.",
          "items": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "additionalProperties": false,
                "description": "What a load admits: exactly one of `catalog`, the registry's packages at a trust tier or above, and `project: true`, the packages the project authored that reach only the connectors the turn already reaches; one that reaches another waits on the person's trust. A registry package the project installed keeps its registry identity, so only `catalog` admits it.",
                "properties": {
                  "catalog": {
                    "additionalProperties": false,
                    "properties": {
                      "trust": {
                        "description": "The lowest tier a load admits on its own; a package below it waits on the person's trust.",
                        "enum": [
                          "first_party",
                          "verified",
                          "community"
                        ],
                        "title": "TrustTier",
                        "type": "string"
                      }
                    },
                    "required": [
                      "trust"
                    ],
                    "title": "CatalogTrust",
                    "type": "object"
                  },
                  "project": {
                    "const": true,
                    "type": "boolean"
                  }
                },
                "title": "CatalogRule",
                "type": "object"
              }
            ],
            "description": "One entry of an allowance's `skills`: a child skill by name, or a catalog rule, which admits the skills and connectors a `load` call finds.",
            "title": "SkillAllowance"
          },
          "minItems": 1,
          "type": "array"
        },
        "tools": {
          "description": "Catalog tool names.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "title": "TurnAllowance",
      "type": "object"
    },
    "context_kinds": {
      "description": "The kinds of context the turn asks its host to supply, as its step's `context.kinds` (N22): a child run's turn gets only what this and its act declare (D31).",
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "envelope": {
      "$id": "https://schemas.runx.ai/runx/agent-context-envelope/v1.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "act": {
          "additionalProperties": false,
          "description": "The act its run's invoker stated: why the run exists, as the run's steps read `$run.act`.",
          "properties": {
            "decision": {
              "description": "The decision the call carries out.",
              "enum": [
                "continue",
                "escalate",
                "defer",
                "close",
                "decline",
                "monitor"
              ],
              "title": "DecisionChoice",
              "type": "string"
            },
            "form": {
              "description": "What kind of act the call is.",
              "enum": [
                "reply",
                "review"
              ],
              "type": "string"
            },
            "previous": {
              "description": "The receipt of the act this one follows.",
              "maxLength": 71,
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "purpose": {
              "description": "Why the call is made.",
              "minLength": 1,
              "type": "string"
            },
            "reason": {
              "description": "What a reader is told about this particular call.",
              "minLength": 1,
              "type": "string"
            },
            "target": {
              "description": "The locator of what the act is about.",
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "purpose"
          ],
          "title": "CallAct",
          "type": "object"
        },
        "context": {
          "additionalProperties": false,
          "description": "The optional conventions and project instructions context block.",
          "properties": {
            "conventions": {
              "additionalProperties": false,
              "description": "A resolved profile sourced from a workspace file (memory, conventions, voice).",
              "properties": {
                "content": {
                  "type": "string"
                },
                "digest": {
                  "minLength": 1,
                  "type": "string"
                },
                "path": {
                  "minLength": 1,
                  "type": "string"
                },
                "root_path": {
                  "minLength": 1,
                  "type": "string"
                },
                "sharing": {
                  "enum": [
                    "local_only",
                    "configured_model"
                  ],
                  "title": "ContextSharing",
                  "type": "string"
                }
              },
              "required": [
                "sharing",
                "root_path",
                "path",
                "digest",
                "content"
              ],
              "title": "ProfileFile",
              "type": "object"
            },
            "instructions": {
              "description": "The project's instructions: each `AGENTS.md` and `CLAUDE.md` from the repository root that contains the workspace down to the workspace, in that order, each `path` relative to the repository root.",
              "items": {
                "additionalProperties": false,
                "description": "A resolved profile sourced from a workspace file (memory, conventions, voice).",
                "properties": {
                  "content": {
                    "type": "string"
                  },
                  "digest": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "path": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "root_path": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "sharing": {
                    "enum": [
                      "local_only",
                      "configured_model"
                    ],
                    "title": "ContextSharing",
                    "type": "string"
                  }
                },
                "required": [
                  "sharing",
                  "root_path",
                  "path",
                  "digest",
                  "content"
                ],
                "title": "ProfileFile",
                "type": "object"
              },
              "minItems": 1,
              "type": "array"
            },
            "memory": {
              "additionalProperties": false,
              "description": "The workspace's `MEMORY.md`, in envelopes recorded before hosts carried memory themselves. runx writes none: memory a host supplies travels as admitted context entries.",
              "properties": {
                "content": {
                  "type": "string"
                },
                "digest": {
                  "minLength": 1,
                  "type": "string"
                },
                "path": {
                  "minLength": 1,
                  "type": "string"
                },
                "root_path": {
                  "minLength": 1,
                  "type": "string"
                },
                "sharing": {
                  "enum": [
                    "local_only",
                    "configured_model"
                  ],
                  "title": "ContextSharing",
                  "type": "string"
                }
              },
              "required": [
                "sharing",
                "root_path",
                "path",
                "digest",
                "content"
              ],
              "title": "ProfileFile",
              "type": "object"
            }
          },
          "title": "AgentContextProfiles",
          "type": "object"
        },
        "current_context": {
          "items": {
            "additionalProperties": false,
            "description": "One entry of context a turn is given (`runx.context_entry.v1`): memory, a skill's instructions, or any other context, with the labels that say how it may be read and where it may go.",
            "properties": {
              "data": {
                "additionalProperties": {},
                "type": "object"
              },
              "labels": {
                "additionalProperties": false,
                "description": "How context may be read and where it may be shared. These labels never grant execution authority or manufacture a human decision.",
                "properties": {
                  "purpose": {
                    "enum": [
                      "procedure",
                      "mandate",
                      "confirmed_memory",
                      "observation"
                    ],
                    "title": "ContextPurpose",
                    "type": "string"
                  },
                  "sharing": {
                    "enum": [
                      "local_only",
                      "configured_model"
                    ],
                    "title": "ContextSharing",
                    "type": "string"
                  },
                  "trust": {
                    "enum": [
                      "person_confirmed",
                      "skill_instructions",
                      "untrusted_evidence"
                    ],
                    "title": "ContextTrust",
                    "type": "string"
                  }
                },
                "required": [
                  "purpose",
                  "trust",
                  "sharing"
                ],
                "title": "ContextLabels",
                "type": "object"
              },
              "origin": {
                "additionalProperties": false,
                "description": "Where a context entry came from: the artifact that holds it, the run and step that produced it, and its bytes' digest and size.",
                "properties": {
                  "artifact_id": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "created_at": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "digest": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "producer": {
                    "additionalProperties": false,
                    "description": "The skill and method that produced a context entry.",
                    "properties": {
                      "method": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "skill": {
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": [
                      "skill",
                      "method"
                    ],
                    "title": "ContextProducer",
                    "type": "object"
                  },
                  "run_id": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "size_bytes": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "step_id": {
                    "anyOf": [
                      {
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "artifact_id",
                  "run_id",
                  "step_id",
                  "producer",
                  "created_at",
                  "digest",
                  "size_bytes"
                ],
                "title": "ContextOrigin",
                "type": "object"
              },
              "schema": {
                "description": "A context entry's schema, `runx.context_entry.v1`.",
                "enum": [
                  "runx.context_entry.v1"
                ],
                "title": "ContextEntrySchema",
                "type": "string"
              },
              "sources": {
                "description": "Where its content came from (D35).",
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              },
              "summary": {
                "description": "What the entry is, in a line, as its producer declares it: what a model reads in an index to choose whether to read the entry's data.",
                "minLength": 1,
                "type": "string"
              },
              "type": {
                "description": "What the entry is.",
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "schema",
              "type",
              "data",
              "labels",
              "sources",
              "origin"
            ],
            "title": "ContextEntry",
            "type": "object"
          },
          "type": "array"
        },
        "execution_location": {
          "additionalProperties": false,
          "description": "Where the skill executes from on disk.",
          "properties": {
            "skill_directory": {
              "minLength": 1,
              "type": "string"
            },
            "tool_roots": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "skill_directory"
          ],
          "title": "ExecutionLocation",
          "type": "object"
        },
        "historical_context": {
          "items": {
            "additionalProperties": false,
            "description": "One entry of context a turn is given (`runx.context_entry.v1`): memory, a skill's instructions, or any other context, with the labels that say how it may be read and where it may go.",
            "properties": {
              "data": {
                "additionalProperties": {},
                "type": "object"
              },
              "labels": {
                "additionalProperties": false,
                "description": "How context may be read and where it may be shared. These labels never grant execution authority or manufacture a human decision.",
                "properties": {
                  "purpose": {
                    "enum": [
                      "procedure",
                      "mandate",
                      "confirmed_memory",
                      "observation"
                    ],
                    "title": "ContextPurpose",
                    "type": "string"
                  },
                  "sharing": {
                    "enum": [
                      "local_only",
                      "configured_model"
                    ],
                    "title": "ContextSharing",
                    "type": "string"
                  },
                  "trust": {
                    "enum": [
                      "person_confirmed",
                      "skill_instructions",
                      "untrusted_evidence"
                    ],
                    "title": "ContextTrust",
                    "type": "string"
                  }
                },
                "required": [
                  "purpose",
                  "trust",
                  "sharing"
                ],
                "title": "ContextLabels",
                "type": "object"
              },
              "origin": {
                "additionalProperties": false,
                "description": "Where a context entry came from: the artifact that holds it, the run and step that produced it, and its bytes' digest and size.",
                "properties": {
                  "artifact_id": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "created_at": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "digest": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "producer": {
                    "additionalProperties": false,
                    "description": "The skill and method that produced a context entry.",
                    "properties": {
                      "method": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "skill": {
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": [
                      "skill",
                      "method"
                    ],
                    "title": "ContextProducer",
                    "type": "object"
                  },
                  "run_id": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "size_bytes": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "step_id": {
                    "anyOf": [
                      {
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "artifact_id",
                  "run_id",
                  "step_id",
                  "producer",
                  "created_at",
                  "digest",
                  "size_bytes"
                ],
                "title": "ContextOrigin",
                "type": "object"
              },
              "schema": {
                "description": "A context entry's schema, `runx.context_entry.v1`.",
                "enum": [
                  "runx.context_entry.v1"
                ],
                "title": "ContextEntrySchema",
                "type": "string"
              },
              "sources": {
                "description": "Where its content came from (D35).",
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              },
              "summary": {
                "description": "What the entry is, in a line, as its producer declares it: what a model reads in an index to choose whether to read the entry's data.",
                "minLength": 1,
                "type": "string"
              },
              "type": {
                "description": "What the entry is.",
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "schema",
              "type",
              "data",
              "labels",
              "sources",
              "origin"
            ],
            "title": "ContextEntry",
            "type": "object"
          },
          "type": "array"
        },
        "inputs": {
          "additionalProperties": {},
          "type": "object"
        },
        "instructions": {
          "minLength": 1,
          "type": "string"
        },
        "instructions_digest": {
          "description": "Digest of the exact bytes carried in `instructions`.",
          "minLength": 1,
          "type": "string"
        },
        "output": {
          "additionalProperties": {
            "additionalProperties": true,
            "description": "One output field: its JSON Schema, `optional: true` when a producer may leave it out, and the `packet` it is kept as.",
            "properties": {
              "optional": {
                "type": "boolean"
              },
              "packet": {
                "type": "string"
              }
            },
            "title": "OutputField",
            "type": "object"
          },
          "type": "object"
        },
        "output_schema": {
          "description": "Exact root JSON Schema for the final result, including any declared packet contract. `output` remains the concise field index used by hosts; this schema is the validator offered to managed agents."
        },
        "provenance": {
          "items": {
            "additionalProperties": false,
            "description": "One input/output provenance edge.",
            "properties": {
              "artifact_id": {
                "type": "string"
              },
              "from_step": {
                "type": "string"
              },
              "input": {
                "minLength": 1,
                "type": "string"
              },
              "output": {
                "minLength": 1,
                "type": "string"
              },
              "receipt_id": {
                "type": "string"
              }
            },
            "required": [
              "input",
              "output"
            ],
            "title": "ProvenanceEntry",
            "type": "object"
          },
          "type": "array"
        },
        "requirements": {
          "additionalProperties": false,
          "description": "Exact non-secret execution requirements selected from the owning manifest, plus environment-name availability. Secret values never enter the agent context.",
          "properties": {
            "declaration": {
              "additionalProperties": false,
              "description": "Parser-owned projection of all execution requirements for one act.",
              "properties": {
                "environment": {
                  "additionalProperties": false,
                  "description": "Environment names consumed by an executable act. Values are resolved only at execution time and never enter this declaration.",
                  "minProperties": 1,
                  "properties": {
                    "optional": {
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1,
                      "type": "array"
                    },
                    "required": {
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1,
                      "type": "array"
                    }
                  },
                  "type": "object"
                },
                "scopes": {
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array"
                }
              },
              "title": "ExecutionRequirements",
              "type": "object"
            },
            "environment": {
              "items": {
                "additionalProperties": false,
                "description": "Safe environment readiness visible to an operating agent. The value is deliberately absent: models receive the requirement and its availability, never ambient or credential material.",
                "properties": {
                  "available": {
                    "type": "boolean"
                  },
                  "name": {
                    "type": "string"
                  },
                  "required": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "required",
                  "available"
                ],
                "title": "EnvironmentRequirementStatus",
                "type": "object"
              },
              "minItems": 1,
              "type": "array"
            },
            "execution_boundary": {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "trusted_host_process",
                    "deterministic_worker",
                    "native_capability",
                    "remote_provider"
                  ],
                  "title": "ExecutionBoundaryKind",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "title": "ExecutionBoundaryObservation",
              "type": "object"
            }
          },
          "required": [
            "declaration",
            "execution_boundary"
          ],
          "title": "AgentExecutionRequirements",
          "type": "object"
        },
        "run_id": {
          "minLength": 1,
          "type": "string"
        },
        "skill": {
          "minLength": 1,
          "type": "string"
        },
        "step_id": {
          "minLength": 1,
          "type": "string"
        },
        "trust_boundary": {
          "minLength": 1,
          "type": "string"
        },
        "voice_profile": {
          "additionalProperties": false,
          "description": "A resolved profile sourced from a workspace file (memory, conventions, voice).",
          "properties": {
            "content": {
              "type": "string"
            },
            "digest": {
              "minLength": 1,
              "type": "string"
            },
            "path": {
              "minLength": 1,
              "type": "string"
            },
            "root_path": {
              "minLength": 1,
              "type": "string"
            },
            "sharing": {
              "enum": [
                "local_only",
                "configured_model"
              ],
              "title": "ContextSharing",
              "type": "string"
            }
          },
          "required": [
            "sharing",
            "root_path",
            "path",
            "digest",
            "content"
          ],
          "title": "ProfileFile",
          "type": "object"
        }
      },
      "required": [
        "run_id",
        "skill",
        "instructions_digest",
        "instructions",
        "inputs",
        "requirements",
        "current_context",
        "historical_context",
        "provenance",
        "trust_boundary"
      ],
      "title": "AgentContextEnvelope",
      "type": "object",
      "x-runx-schema": "runx.agent_context_envelope.v1"
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "requires": {
      "description": "What the turn needs from its agent harness, as its step's `requires`. An agent harness that meets one says so in its answer's `closure.requirements`; one that can't ends the act failed with `closure.unsupported_requirement`.",
      "items": {
        "description": "What a turn can need from the agent harness that works it.",
        "enum": [
          "native_tools",
          "fresh_context",
          "separate_reviewer"
        ],
        "title": "TurnRequirement",
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "task": {
      "description": "The task it performs: a `## Agent task: <name>` section of the package's `SKILL.md`, which carries its instructions.",
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "id",
    "task",
    "envelope",
    "allowance"
  ],
  "title": "TurnInvocation",
  "type": "object",
  "x-runx-schema": "runx.turn_invocation.v1"
}
