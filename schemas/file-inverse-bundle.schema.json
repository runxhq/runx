{
  "$id": "https://schemas.runx.ai/runx/fs/inverse-bundle/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What `fs.inverse` returns: the bundle that undoes a run's edits, for `fs.apply_bundle` to apply.",
  "properties": {
    "calls": {
      "description": "The calls it undoes, in the order the run made them.",
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "deletes": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/FileBoundDelete"
      },
      "type": "array"
    },
    "repo_root": {
      "description": "The root the edits changed, relative to the workspace.",
      "minLength": 1,
      "type": "string"
    },
    "writes": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/FileBundleWrite"
      },
      "type": "array"
    }
  },
  "required": [
    "repo_root",
    "writes",
    "deletes",
    "calls"
  ],
  "title": "FileInverseBundle",
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.fs.inverse_bundle.v1"
}
