{
  "$id": "https://schemas.runx.ai/runx/skill/apply-result/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_digest": {
      "minLength": 1,
      "type": "string"
    },
    "changed_paths": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "decision": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/SkillChangeDecision"
    },
    "deleted_paths": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "package_digest": {
      "description": "The execution package digest of the applied package, not the registry's digest of its published package files.",
      "minLength": 1,
      "type": "string"
    },
    "plan_digest": {
      "minLength": 1,
      "type": "string"
    },
    "residual_risks": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "schema": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/SkillApplyResultSchema"
    },
    "target_dir": {
      "minLength": 1,
      "type": "string"
    },
    "validation": {
      "$ref": "https://schemas.runx.ai/runx/skill/validation-result/v1.json"
    },
    "verdict": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/SkillApplyVerdict"
    }
  },
  "required": [
    "schema",
    "target_dir",
    "decision",
    "verdict",
    "base_digest",
    "plan_digest",
    "package_digest",
    "changed_paths",
    "deleted_paths",
    "residual_risks"
  ],
  "title": "SkillApplyResult",
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.skill.apply_result.v1"
}
