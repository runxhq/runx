{
  "$id": "https://schemas.runx.ai/runx/external-job-stage/request/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Exact package re-entry input for one persisted stage.",
  "properties": {
    "checkpoint": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/ExternalJobCheckpoint"
    },
    "continuation": {
      "$ref": "https://schemas.runx.ai/runx/external-job-continuation/v1.json"
    },
    "operation_key": {
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "continuation",
    "checkpoint",
    "operation_key"
  ],
  "title": "ExternalJobStageRequest",
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.external_job_stage.request.v1"
}
