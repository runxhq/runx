      "type": "string"
    },
    "data": {
      "type": "string"
    },
    "encoding": {
      "type": "string"
    },
    "eof": {
      "type": "boolean"
    },
    "length": {
      "type": "integer"
    },
    "media_type": {
      "type": "string"
    },
    "next_offset": {
