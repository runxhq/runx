{
  "$id": "https://schemas.runx.ai/runx/ledger-entry/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "chain": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "description": "The algorithm a content digest was taken with.",
          "enum": [
            "sha256"
          ],
          "title": "DigestAlgorithm",
          "type": "string"
        },
        "canonicalization": {
          "enum": [
            "runx.stable-json.v1"
          ],
          "title": "LedgerCanonicalization",
          "type": "string"
        },
        "entry_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "index": {
          "minimum": 0,
          "type": "integer"
        },
        "previous_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "enum": [
            "runx.ledger.chain.v1"
          ],
          "title": "LedgerChainVersion",
          "type": "string"
        }
      },
      "required": [
        "version",
        "algorithm",
        "canonicalization",
        "index",
        "previous_digest",
        "entry_digest"
      ],
      "title": "LedgerChain",
      "type": "object"
    },
    "entry": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "additionalProperties": {},
          "type": "object"
        },
        "meta": {
          "additionalProperties": false,
          "properties": {
            "artifact_id": {
              "minLength": 1,
              "type": "string"
            },
            "created_at": {
              "minLength": 1,
              "type": "string"
            },
            "digest": {
              "minLength": 1,
              "type": "string"
            },
            "parent_artifact_id": {
              "anyOf": [
                {
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "producer": {
              "additionalProperties": false,
              "properties": {
                "runner": {
                  "minLength": 1,
                  "type": "string"
                },
                "skill": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "skill",
                "runner"
              ],
              "title": "LedgerProducer",
              "type": "object"
            },
            "receipt_id": {
              "anyOf": [
                {
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "redacted": {
              "type": "boolean"
            },
            "run_id": {
              "minLength": 1,
              "type": "string"
            },
            "size_bytes": {
              "minimum": 0,
              "type": "integer"
            },
            "step_id": {
              "anyOf": [
                {
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "artifact_id",
            "run_id",
            "step_id",
            "producer",
            "created_at",
            "digest",
            "size_bytes",
            "parent_artifact_id",
            "receipt_id",
            "redacted"
          ],
          "title": "LedgerEntryMeta",
          "type": "object"
        },
        "type": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "enum": [
            "1"
          ],
          "title": "LedgerPayloadVersion",
          "type": "string"
        }
      },
      "required": [
        "type",
        "version",
        "data",
        "meta"
      ],
      "title": "LedgerPayload",
      "type": "object"
    },
    "schema_version": {
      "enum": [
        "runx.ledger.entry.v1"
      ],
      "title": "LedgerEntrySchemaVersion",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "chain",
    "entry"
  ],
  "title": "LedgerEntry",
  "type": "object",
  "x-runx-schema": "runx.ledger.entry.v1"
}
