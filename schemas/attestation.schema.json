{
  "$id": "https://schemas.runx.ai/runx/attestation/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What `receipt.attest` returns: one claim about an action outside runx, bound to opaque evidence and digested for the parent receipt to seal. A field the tool could not admit is null and a gap says why; a `ready_to_seal` attestation has no gaps.",
  "properties": {
    "action": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "attestation_digest": {
      "description": "The digest of the action, claim, principal, evidence and scope.",
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "claim": {
      "anyOf": [
        {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "decision": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/AttestationDecision"
    },
    "evidence": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/AttestationEvidence"
      },
      "maxItems": 100,
      "minItems": 0,
      "type": "array"
    },
    "gaps": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/AttestationGap"
      },
      "type": "array"
    },
    "principal": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "proof_boundary": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/AttestationProofBoundary"
    },
    "schema": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/AttestationSchema"
    },
    "scope": {
      "additionalProperties": {},
      "description": "Who or what may rely on the claim.",
      "type": "object"
    }
  },
  "required": [
    "schema",
    "decision",
    "action",
    "claim",
    "principal",
    "evidence",
    "scope",
    "attestation_digest",
    "gaps",
    "proof_boundary"
  ],
  "title": "Attestation",
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.attestation.v1"
}
