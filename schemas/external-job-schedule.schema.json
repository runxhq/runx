    "principal_ref",
    "vendor_ref",
    "invocation_ref",
    "source_run_ref",
    "execution_binding",
    "operation_identity",
    "checkpoint",
    "max_attempts",
    "next_attempt_at",
    "deadline_at",
    "created_at"
  ],
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.external_job_schedule.v1"
