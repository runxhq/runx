          "type": "string"
        },
        "proof_kind": {
          "enum": [
            "effect_evidence",
            "effect_finality",
            "credential_resolution"
          ],
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "type": "string"
        },
        "schema": {
          "const": "runx.reference.v1",
          "type": "string"
        },
        "type": {
          "const": "principal",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "type",
        "uri"
      ],
      "type": "object",
      "x-runx-schema": "runx.reference.v1"
    },
