{
  "$id": "https://schemas.runx.ai/runx/skill-lab/authoring-context/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What `runx.skill.inspect` returns: the workspace a skill change is authored in, its target package as it stands, and the catalog it can reuse.",
  "properties": {
    "base_digest": {
      "description": "The digest a change to the target binds to.",
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "catalog_root": {
      "description": "Where catalog skills live, relative to `repo_root`.",
      "minLength": 1,
      "type": "string"
    },
    "catalog_skills": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/SkillCatalogEntry"
      },
      "type": "array"
    },
    "core_tools": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/SkillCatalogEntry"
      },
      "type": "array"
    },
    "repo_root": {
      "minLength": 1,
      "type": "string"
    },
    "target_dir": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "The target package, relative to `repo_root`; null when none was named."
    },
    "target_exists": {
      "type": "boolean"
    },
    "target_files": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/SkillPackageFile"
      },
      "type": "array"
    },
    "target_inspection": {
      "anyOf": [
        {
          "additionalProperties": {},
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "description": "The existing target's inspection, or why it would not inspect; null when the target does not exist."
    },
    "target_metrics": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/SkillPackageMetrics"
    }
  },
  "required": [
    "repo_root",
    "target_dir",
    "target_exists",
    "base_digest",
    "target_files",
    "target_metrics",
    "target_inspection",
    "catalog_root",
    "catalog_skills",
    "core_tools"
  ],
  "title": "SkillAuthoringContext",
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.skill_lab.authoring_context.v1"
}
