{
  "$id": "https://schemas.runx.ai/runx/readiness/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "connector": {
      "maxLength": 129,
      "pattern": "^(?!versions(?:/|$))[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?(?:/(?!versions$)[a-z][a-z0-9-]{0,62}[a-z0-9])?$",
      "type": "string"
    },
    "cost": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/OperationCost",
      "description": "What the provider charges per call, when the operation declares it."
    },
    "instance_id": {
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "type": "string"
    },
    "operation": {
      "maxLength": 100,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "type": "string"
    },
    "placement": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/Placement"
    },
    "ready": {
      "description": "True when no check failed. Approval may still be owed at call time.",
      "type": "boolean"
    },
    "reasons": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/AdmissionReason"
      },
      "type": "array"
    },
    "requirement": {
      "description": "The skill requirement key.",
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "requirement",
    "operation",
    "ready",
    "reasons"
  ],
  "title": "Readiness",
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.readiness.v1"
}
