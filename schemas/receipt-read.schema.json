{
  "$id": "https://schemas.runx.ai/runx/receipt/read/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A selected value from the exact declared claim a receipt seals. The outcome digest binds the complete claim, outcome and child references; selecting a pointer is a native verified read, not a Merkle proof.",
  "properties": {
    "bytes": {
      "description": "Serialized UTF-8 bytes of the selected value; zero when unavailable.",
      "minimum": 0,
      "type": "integer"
    },
    "children": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/reference/v1.json"
      },
      "type": "array"
    },
    "issuer_type": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/ReceiptIssuerType"
    },
    "json_pointer": {
      "type": "string"
    },
    "outcome": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/RunOutcome"
    },
    "outcome_digest": {
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "receipt_id": {
      "minLength": 1,
      "type": "string"
    },
    "root_receipt_id": {
      "description": "When supplied to the reader, this original root was verified and the selected receipt is its root or one of its signed descendants.",
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/ReceiptReadSchema"
    },
    "status": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/ReceiptReadStatus"
    },
    "subject_kind": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/SubjectKind"
    },
    "subject_uri": {
      "minLength": 1,
      "type": "string"
    },
    "value": {
      "anyOf": [
        {},
        {
          "type": "null"
        }
      ],
      "description": "The selected declared output, including any sensitive source data it contains. Invocation inputs, credential stores and transport diagnostics are not loaded. Null is valid when status is available."
    }
  },
  "required": [
    "schema",
    "status",
    "receipt_id",
    "subject_kind",
    "subject_uri",
    "issuer_type",
    "outcome",
    "outcome_digest",
    "children",
    "json_pointer",
    "value",
    "bytes"
  ],
  "title": "ReceiptRead",
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.receipt.read.v1"
}
