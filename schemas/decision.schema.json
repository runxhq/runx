{
  "$id": "https://schemas.runx.ai/runx/decision/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "choice": {
      "description": "The decisions a governed call can carry out.",
      "enum": [
        "continue",
        "escalate",
        "defer",
        "close",
        "decline",
        "monitor"
      ],
      "title": "DecisionChoice",
      "type": "string"
    },
    "decision_id": {
      "minLength": 1,
      "type": "string"
    },
    "selected_act_id": {
      "description": "The act the decision is carried out by. Its intent, target and artifacts are that act's.",
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "decision_id",
    "choice",
    "selected_act_id"
  ],
  "title": "Decision",
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.decision.v1"
}
