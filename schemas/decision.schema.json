{
  "$id": "https://schemas.runx.ai/runx/decision/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "choice": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/DecisionChoice"
    },
    "decision_id": {
      "minLength": 1,
      "type": "string"
    },
    "selected_act_id": {
