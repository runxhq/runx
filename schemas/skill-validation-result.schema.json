{
  "$id": "https://schemas.runx.ai/runx/skill/validation-result/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "after": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/SkillPackageMetrics"
    },
    "base_digest": {
      "minLength": 1,
      "type": "string"
    },
    "before": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/SkillPackageMetrics"
    },
    "candidate_digest": {
      "minLength": 1,
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/SkillValidationCheck"
      },
      "type": "array"
    },
    "delta": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/SkillPackageDelta"
    },
    "plan_digest": {
      "minLength": 1,
      "type": "string"
    },
    "residual_risks": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "schema": {
      "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/SkillValidationResultSchema"
    },
    "target_dir": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema",
    "target_dir",
    "base_digest",
    "plan_digest",
    "candidate_digest",
    "checks",
    "before",
    "after",
    "delta",
    "residual_risks"
  ],
  "title": "SkillValidationResult",
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.skill.validation_result.v1"
}
