{
  "$id": "https://schemas.runx.ai/runx/external-job-stage/result/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "additionalProperties": false,
      "properties": {
        "checkpoint": {
          "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/ExternalJobCheckpoint"
        },
        "provider_job_ref": {
          "$ref": "https://schemas.runx.ai/runx/reference/v1.json"
        },
        "retry_after_ms": {
          "maximum": 300000,
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "const": "waiting",
          "type": "string"
        }
      },
      "required": [
        "status",
        "provider_job_ref",
        "checkpoint",
        "retry_after_ms"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "checkpoint": {
          "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/ExternalJobCheckpoint"
        },
        "provider_job_ref": {
          "$ref": "https://schemas.runx.ai/runx/reference/v1.json"
        },
        "retry_after_ms": {
          "maximum": 300000,
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "const": "materialize",
          "type": "string"
        }
      },
      "required": [
        "status",
        "provider_job_ref",
        "checkpoint",
        "retry_after_ms"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "evidence_digest": {
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "evidence_ref": {
          "$ref": "https://schemas.runx.ai/runx/reference/v1.json"
        },
        "provider_job_ref": {
          "$ref": "https://schemas.runx.ai/runx/reference/v1.json"
        },
        "result_artifact_ref": {
          "$ref": "https://schemas.runx.ai/runx/reference/v1.json"
        },
        "status": {
          "const": "ready",
          "type": "string"
        }
      },
      "required": [
        "status",
        "provider_job_ref",
        "result_artifact_ref",
        "evidence_ref",
        "evidence_digest"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "evidence_digest": {
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "evidence_ref": {
          "$ref": "https://schemas.runx.ai/runx/reference/v1.json"
        },
        "failure": {
          "$ref": "https://schemas.runx.ai/runx/definitions/v1.json#/$defs/ExternalJobFailure"
        },
        "provider_job_ref": {
          "$ref": "https://schemas.runx.ai/runx/reference/v1.json"
        },
        "status": {
          "const": "provider_failed",
          "type": "string"
        }
      },
      "required": [
        "status",
        "provider_job_ref",
        "evidence_ref",
        "evidence_digest",
        "failure"
      ],
      "type": "object"
    }
  ],
  "description": "Provider-neutral package result. Runx owns scheduling and finalization; the package owns only the meaning of each stage.",
  "title": "ExternalJobStageResult",
  "x-runx-packet": true,
  "x-runx-schema": "runx.external_job_stage.result.v1"
}
