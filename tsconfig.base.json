{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "ignoreDeprecations": "6.0",
    "types": [
      "node"
    ],
    "paths": {
      "@runxhq/extension-sdk": [
        "./packages/extension-sdk/src/index.ts"
      ],
      "@runxhq/contracts": [
        "./packages/contracts/src/index.ts"
      ],
      "@runxhq/client": [
        "./packages/client/src/index.ts"
      ],
      "@runxhq/client/adapters": [
        "./packages/client/src/adapters/index.ts"
      ]
    }
  }
}
