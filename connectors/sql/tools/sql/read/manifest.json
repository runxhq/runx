{
  "schema": "runx.tool.manifest.v1",
  "name": "sql.read",
  "version": "0.1.0",
  "description": "Read the selected SQL source's declared query catalog or execute one parameterized query through its installed SQLAlchemy dialect and driver.",
  "process": {
    "command": "python3",
    "args": ["./read.py"],
    "inputs_via": "stdin",
    "timeout_seconds": 30
  },
  "inputs": {
    "action": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "query_id": {
      "type": "string",
      "optional": true
    },
    "parameters": {
      "type": "object",
      "optional": true
    },
    "max_rows": {
      "type": "integer",
      "optional": true
    }
  }
}
